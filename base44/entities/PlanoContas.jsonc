{
  "name": "PlanoContas",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "numero_plano": {
      "type": "string",
      "description": "N\u00famero sequencial do plano"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo hier\u00e1rquico (1.0, 1.1, 1.1.1, etc)"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da conta"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Receita",
        "Despesa"
      ],
      "description": "Tipo da conta"
    },
    "plano_pai_id": {
      "type": "string",
      "description": "ID do plano pai (hierarquia)"
    },
    "nivel": {
      "type": "number",
      "description": "N\u00edvel na hierarquia (1, 2, 3, etc)"
    },
    "aceita_lancamento": {
      "type": "boolean",
      "default": true,
      "description": "Se aceita lan\u00e7amentos diretos"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se est\u00e1 ativo"
    }
  },
  "required": [
    "empresa_id",
    "codigo",
    "descricao",
    "tipo"
  ]
}
{
  "name": "BebedouroSanidade",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa/fazenda"
    },
    "bebedouro_id": {
      "type": "string",
      "description": "ID do bebedouro"
    },
    "bebedouro_nome": {
      "type": "string",
      "description": "Nome do bebedouro"
    },
    "data_avaliacao": {
      "type": "string",
      "format": "date",
      "description": "Data da avalia\u00e7\u00e3o"
    },
    "responsavel": {
      "type": "string",
      "description": "Respons\u00e1vel pela avalia\u00e7\u00e3o"
    },
    "cor_agua": {
      "type": "string",
      "description": "Cor da \u00e1gua"
    },
    "odor": {
      "type": "string",
      "description": "Odor identificado"
    },
    "turbidez": {
      "type": "string",
      "description": "Turbidez da \u00e1gua"
    },
    "presenca_algas": {
      "type": "boolean",
      "default": false,
      "description": "Presen\u00e7a de algas"
    },
    "presenca_barro": {
      "type": "boolean",
      "default": false,
      "description": "Presen\u00e7a de barro"
    },
    "presenca_contaminacao": {
      "type": "boolean",
      "default": false,
      "description": "Presen\u00e7a de contamina\u00e7\u00e3o"
    },
    "necessita_limpeza": {
      "type": "boolean",
      "default": false,
      "description": "Necessita limpeza"
    },
    "necessita_tratamento": {
      "type": "boolean",
      "default": false,
      "description": "Necessita tratamento"
    },
    "nivel_risco": {
      "type": "string",
      "enum": [
        "Baixo",
        "M\u00e9dio",
        "Alto"
      ],
      "default": "Baixo",
      "description": "N\u00edvel de risco"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sanit\u00e1rias"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Fotos da avalia\u00e7\u00e3o"
    }
  },
  "required": [
    "empresa_id",
    "bebedouro_id",
    "data_avaliacao",
    "nivel_risco"
  ]
}
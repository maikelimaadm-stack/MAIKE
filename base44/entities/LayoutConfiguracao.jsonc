{
  "name": "LayoutConfiguracao",
  "type": "object",
  "properties": {
    "tela": {
      "type": "string",
      "description": "Identificador da tela/m\u00f3dulo"
    },
    "nome": {
      "type": "string",
      "description": "Nome amig\u00e1vel do layout"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do layout"
    },
    "escopo": {
      "type": "string",
      "enum": [
        "usuario",
        "empresa",
        "sistema"
      ],
      "default": "sistema",
      "description": "N\u00edvel de aplica\u00e7\u00e3o do layout"
    },
    "empresa_id": {
      "type": "string",
      "description": "Empresa vinculada quando escopo for empresa"
    },
    "user_email": {
      "type": "string",
      "description": "Usu\u00e1rio vinculado quando escopo for usu\u00e1rio"
    },
    "versao_ativa": {
      "type": "number",
      "default": 1,
      "description": "Vers\u00e3o ativa do layout"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o layout est\u00e1 ativo"
    },
    "metadata": {
      "type": "object",
      "description": "Configura\u00e7\u00f5es adicionais do layout"
    }
  },
  "required": [
    "tela",
    "nome",
    "escopo"
  ]
}
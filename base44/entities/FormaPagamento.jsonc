{
  "name": "FormaPagamento",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "numero_forma": {
      "type": "string",
      "description": "N\u00famero \u00fanico da forma (gerado automaticamente)"
    },
    "nome": {
      "type": "string",
      "description": "Nome da forma de pagamento"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Entrada",
        "Saida",
        "Ambos"
      ],
      "description": "Se aplica a Entrada, Sa\u00edda ou Ambos"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Dinheiro",
        "PIX",
        "Boleto",
        "CartaoCredito",
        "CartaoDebito",
        "Transferencia",
        "Cheque",
        "Deposito",
        "Outros"
      ],
      "description": "Categoria do meio de pagamento"
    },
    "permite_parcelamento": {
      "type": "boolean",
      "default": false,
      "description": "Se permite parcelamento"
    },
    "prazo_compensacao_dias": {
      "type": "number",
      "default": 0,
      "description": "Prazo em dias para compensa\u00e7\u00e3o"
    },
    "taxa_percentual": {
      "type": "number",
      "default": 0,
      "description": "Taxa percentual cobrada"
    },
    "taxa_fixa": {
      "type": "number",
      "default": 0,
      "description": "Taxa fixa por transa\u00e7\u00e3o (R$)"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se est\u00e1 ativo"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o opcional"
    },
    "ordem": {
      "type": "number",
      "description": "Ordem num\u00e9rica para exibi\u00e7\u00e3o"
    },
    "conta_bancaria": {
      "type": "string",
      "description": "Conta banc\u00e1ria vinculada (legado)"
    },
    "padrao": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 a forma padr\u00e3o"
    },
    "prazo_padrao_dias": {
      "type": "number",
      "default": 0,
      "description": "Prazo padr\u00e3o em dias (legado)"
    }
  },
  "required": [
    "empresa_id",
    "nome",
    "tipo",
    "categoria"
  ]
}
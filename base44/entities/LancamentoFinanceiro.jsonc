{
  "name": "LancamentoFinanceiro",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "numero_lancamento": {
      "type": "string",
      "description": "N\u00famero sequencial autom\u00e1tico do lan\u00e7amento"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Pagar",
        "Receber"
      ],
      "description": "Tipo do lan\u00e7amento: despesa (Pagar) ou receita (Receber)"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do lan\u00e7amento"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aberto",
        "Parcial",
        "Pago",
        "Recebido",
        "Cancelado"
      ],
      "default": "Aberto",
      "description": "Status atual do lan\u00e7amento/parcela"
    },
    "valor_total": {
      "type": "number",
      "description": "Valor desta parcela"
    },
    "valor_pago": {
      "type": "number",
      "default": 0,
      "description": "Valor j\u00e1 pago/recebido desta parcela"
    },
    "valor_total_lancamento": {
      "type": "number",
      "description": "Valor total original do lan\u00e7amento inteiro (soma de todas as parcelas)"
    },
    "data_emissao": {
      "type": "string",
      "format": "date",
      "description": "Data de emiss\u00e3o do documento"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento desta parcela"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date",
      "description": "Data efetiva de pagamento/recebimento desta parcela"
    },
    "fornecedor_id": {
      "type": "string",
      "description": "ID do fornecedor (tipo Pagar)"
    },
    "fornecedor_nome": {
      "type": "string",
      "description": "Nome do fornecedor (cache)"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente (tipo Receber)"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente (cache)"
    },
    "tipo_documento_id": {
      "type": "string",
      "description": "ID do tipo de documento"
    },
    "tipo_documento_nome": {
      "type": "string",
      "description": "Nome do tipo de documento (cache)"
    },
    "numero_documento": {
      "type": "string",
      "description": "N\u00famero do documento fiscal/comprovante"
    },
    "conta_financeira_id": {
      "type": "string",
      "description": "ID da conta financeira vinculada"
    },
    "conta_financeira_nome": {
      "type": "string",
      "description": "Nome da conta financeira (cache)"
    },
    "forma_pagamento_id": {
      "type": "string",
      "description": "ID da forma de pagamento"
    },
    "forma_pagamento_nome": {
      "type": "string",
      "description": "Nome da forma de pagamento (cache)"
    },
    "motivo_compra_id": {
      "type": "string",
      "description": "ID do motivo de compra"
    },
    "motivo_compra_nome": {
      "type": "string",
      "description": "Nome do motivo de compra (cache)"
    },
    "parcelamento_grupo_id": {
      "type": "string",
      "description": "ID \u00fanico que agrupa todas as parcelas de um mesmo lan\u00e7amento"
    },
    "numero_parcela_seq": {
      "type": "number",
      "description": "N\u00famero sequencial da parcela (1, 2, 3...)"
    },
    "total_parcelas_grupo": {
      "type": "number",
      "description": "Total de parcelas neste grupo"
    },
    "is_registro_principal": {
      "type": "boolean",
      "default": false,
      "description": "Indica se \u00e9 o registro principal do grupo (parcela 1). Edi\u00e7\u00f5es aqui propagam para as demais."
    },
    "rateio_grupos": {
      "type": "array",
      "description": "Distribui\u00e7\u00e3o por grupos financeiros",
      "items": {
        "type": "object",
        "properties": {
          "grupo_financeiro_id": {
            "type": "string"
          },
          "grupo_financeiro_nome": {
            "type": "string"
          },
          "valor": {
            "type": "number"
          },
          "percentual": {
            "type": "number"
          }
        },
        "required": [
          "grupo_financeiro_id",
          "valor"
        ]
      }
    },
    "rateio_centros_custo": {
      "type": "array",
      "description": "Distribui\u00e7\u00e3o por centros de custo",
      "items": {
        "type": "object",
        "properties": {
          "centro_custo_id": {
            "type": "string"
          },
          "centro_custo_nome": {
            "type": "string"
          },
          "valor": {
            "type": "number"
          },
          "percentual": {
            "type": "number"
          }
        },
        "required": [
          "centro_custo_id",
          "valor"
        ]
      }
    },
    "plano_contas_id": {
      "type": "string",
      "description": "ID do plano de contas vinculado"
    },
    "plano_contas_nome": {
      "type": "string",
      "description": "Nome do plano de contas (cache)"
    },
    "produtos_lancamento": {
      "type": "array",
      "description": "Lista de produtos vinculados ao lan\u00e7amento",
      "items": {
        "type": "object",
        "properties": {
          "produto_id": {
            "type": "string"
          },
          "produto_nome": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          },
          "unidade": {
            "type": "string"
          },
          "valor_unitario": {
            "type": "number"
          },
          "desconto_item": {
            "type": "number"
          },
          "valor_total": {
            "type": "number"
          }
        },
        "required": [
          "produto_id",
          "quantidade",
          "valor_total"
        ]
      }
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais do lan\u00e7amento"
    },
    "observacao_parcela": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o espec\u00edfica desta parcela"
    },
    "anexos_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs de anexos e comprovantes"
    }
  },
  "required": [
    "empresa_id",
    "tipo",
    "descricao",
    "valor_total",
    "data_emissao",
    "data_vencimento",
    "conta_financeira_id",
    "forma_pagamento_id"
  ]
}
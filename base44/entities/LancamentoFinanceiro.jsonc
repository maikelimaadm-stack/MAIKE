{
  "name": "LancamentoFinanceiro",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Pagar",
        "Receber"
      ],
      "description": "Tipo do lan\u00e7amento: despesa (Pagar) ou receita (Receber)"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do lan\u00e7amento"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aberto",
        "Parcial",
        "Pago",
        "Recebido",
        "Cancelado"
      ],
      "default": "Aberto",
      "description": "Status atual do lan\u00e7amento"
    },
    "valor_total": {
      "type": "number",
      "description": "Valor total l\u00edquido do lan\u00e7amento"
    },
    "valor_pago": {
      "type": "number",
      "default": 0,
      "description": "Valor j\u00e1 pago/recebido"
    },
    "data_emissao": {
      "type": "string",
      "format": "date",
      "description": "Data de emiss\u00e3o do documento"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento (parcela \u00fanica ou primeira parcela)"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date",
      "description": "Data efetiva de pagamento/recebimento"
    },
    "fornecedor_id": {
      "type": "string",
      "description": "ID do fornecedor (tipo Pagar)"
    },
    "fornecedor_nome": {
      "type": "string",
      "description": "Nome do fornecedor (cache)"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente (tipo Receber)"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente (cache)"
    },
    "tipo_documento_id": {
      "type": "string",
      "description": "ID do tipo de documento (cadastro TipoDocumento)"
    },
    "tipo_documento_nome": {
      "type": "string",
      "description": "Nome do tipo de documento (cache)"
    },
    "numero_documento": {
      "type": "string",
      "description": "N\u00famero do documento fiscal/comprovante"
    },
    "conta_financeira_id": {
      "type": "string",
      "description": "ID da conta financeira vinculada (cadastro ContaFinanceira)"
    },
    "conta_financeira_nome": {
      "type": "string",
      "description": "Nome da conta financeira (cache)"
    },
    "forma_pagamento_id": {
      "type": "string",
      "description": "ID da forma de pagamento (cadastro FormaPagamento)"
    },
    "forma_pagamento_nome": {
      "type": "string",
      "description": "Nome da forma de pagamento (cache)"
    },
    "motivo_compra_id": {
      "type": "string",
      "description": "ID do motivo de compra (cadastro MotivoCompra)"
    },
    "motivo_compra_nome": {
      "type": "string",
      "description": "Nome do motivo de compra (cache)"
    },
    "parcelado": {
      "type": "boolean",
      "default": false,
      "description": "Se o lan\u00e7amento \u00e9 parcelado"
    },
    "quantidade_parcelas": {
      "type": "number",
      "description": "N\u00famero total de parcelas"
    },
    "parcelas": {
      "type": "array",
      "description": "Lista de parcelas com data e valor individual",
      "items": {
        "type": "object",
        "properties": {
          "numero": {
            "type": "number",
            "description": "N\u00famero da parcela (1, 2, 3...)"
          },
          "data_vencimento": {
            "type": "string",
            "format": "date",
            "description": "Data de vencimento da parcela"
          },
          "valor": {
            "type": "number",
            "description": "Valor da parcela"
          },
          "status": {
            "type": "string",
            "enum": [
              "Aberto",
              "Pago",
              "Recebido",
              "Cancelado"
            ],
            "description": "Status individual da parcela"
          },
          "data_pagamento": {
            "type": "string",
            "format": "date",
            "description": "Data efetiva de pagamento da parcela"
          },
          "valor_pago": {
            "type": "number",
            "description": "Valor efetivamente pago nesta parcela"
          }
        },
        "required": [
          "numero",
          "data_vencimento",
          "valor"
        ]
      }
    },
    "rateio_grupos": {
      "type": "array",
      "description": "Distribui\u00e7\u00e3o do valor por grupos financeiros (receita/despesa). Soma dos valores deve ser igual ao valor_total. O percentual \u00e9 calculado automaticamente.",
      "items": {
        "type": "object",
        "properties": {
          "grupo_financeiro_id": {
            "type": "string",
            "description": "ID do grupo financeiro"
          },
          "grupo_financeiro_nome": {
            "type": "string",
            "description": "Nome do grupo financeiro (cache)"
          },
          "valor": {
            "type": "number",
            "description": "Valor distribu\u00eddo neste grupo"
          },
          "percentual": {
            "type": "number",
            "description": "Percentual calculado automaticamente (valor / valor_total * 100)"
          }
        },
        "required": [
          "grupo_financeiro_id",
          "valor"
        ]
      }
    },
    "rateio_centros_custo": {
      "type": "array",
      "description": "Distribui\u00e7\u00e3o do valor por centros de custo. Soma dos valores deve ser igual ao valor_total. O percentual \u00e9 calculado automaticamente.",
      "items": {
        "type": "object",
        "properties": {
          "centro_custo_id": {
            "type": "string",
            "description": "ID do centro de custo"
          },
          "centro_custo_nome": {
            "type": "string",
            "description": "Nome do centro de custo (cache)"
          },
          "valor": {
            "type": "number",
            "description": "Valor distribu\u00eddo neste centro de custo"
          },
          "percentual": {
            "type": "number",
            "description": "Percentual calculado automaticamente (valor / valor_total * 100)"
          }
        },
        "required": [
          "centro_custo_id",
          "valor"
        ]
      }
    },
    "plano_contas_id": {
      "type": "string",
      "description": "ID do plano de contas vinculado"
    },
    "plano_contas_nome": {
      "type": "string",
      "description": "Nome do plano de contas (cache)"
    },
    "produtos_lancamento": {
      "type": "array",
      "description": "Lista de produtos vinculados ao lan\u00e7amento",
      "items": {
        "type": "object",
        "properties": {
          "produto_id": {
            "type": "string"
          },
          "produto_nome": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          },
          "unidade": {
            "type": "string"
          },
          "valor_unitario": {
            "type": "number"
          },
          "desconto_item": {
            "type": "number"
          },
          "valor_total": {
            "type": "number"
          }
        },
        "required": [
          "produto_id",
          "quantidade",
          "valor_total"
        ]
      }
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais"
    },
    "anexos_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs de anexos e comprovantes"
    }
  },
  "required": [
    "empresa_id",
    "tipo",
    "descricao",
    "valor_total",
    "data_emissao",
    "data_vencimento",
    "conta_financeira_id",
    "forma_pagamento_id"
  ]
}
{
  "name": "PlanoAcao",
  "type": "object",
  "properties": {
    "nome_plano": {
      "type": "string",
      "description": "Nome do plano de a\u00e7\u00e3o"
    },
    "status_plano": {
      "type": "string",
      "enum": [
        "Rascunho",
        "Ativo",
        "Conclu\u00eddo",
        "Cancelado"
      ],
      "default": "Rascunho",
      "description": "Status do plano"
    },
    "solicitante_id": {
      "type": "string",
      "description": "ID do solicitante (Pessoa/Contato)"
    },
    "solicitante_nome": {
      "type": "string",
      "description": "Nome do solicitante (cache)"
    },
    "descricao_objetivo": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o/Objetivo"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "Baixa",
        "M\u00e9dia",
        "Alta"
      ],
      "description": "Prioridade do plano"
    },
    "area_padrao_id": {
      "type": "string",
      "description": "\u00c1rea padr\u00e3o (opcional)"
    },
    "area_padrao_nome": {
      "type": "string",
      "description": "Nome da \u00e1rea padr\u00e3o (cache)"
    },
    "data_prevista_inicio": {
      "type": "string",
      "format": "date",
      "description": "Data prevista de in\u00edcio"
    },
    "data_prevista_fim": {
      "type": "string",
      "format": "date",
      "description": "Data prevista de fim"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    },
    "anexos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs de anexos/fotos"
    }
  },
  "required": [
    "nome_plano",
    "status_plano",
    "solicitante_id"
  ]
}
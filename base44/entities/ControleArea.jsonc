{
  "name": "ControleArea",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "setor_id": {
      "type": "string",
      "description": "ID do setor vinculado"
    },
    "setor_nome": {
      "type": "string",
      "description": "Nome do setor vinculado"
    },
    "area_id": {
      "type": "string",
      "description": "ID da \u00e1rea"
    },
    "area_nome": {
      "type": "string",
      "description": "Nome da \u00e1rea (cache)"
    },
    "safra_id": {
      "type": "string",
      "description": "ID da safra"
    },
    "safra_nome": {
      "type": "string",
      "description": "Nome da safra (cache)"
    },
    "cultura": {
      "type": "string",
      "description": "Cultura plantada"
    },
    "variedade": {
      "type": "string",
      "description": "Variedade da cultura"
    },
    "data_plantio": {
      "type": "string",
      "format": "date",
      "description": "Data do plantio"
    },
    "data_colheita_prevista": {
      "type": "string",
      "format": "date",
      "description": "Data prevista de colheita"
    },
    "data_colheita_real": {
      "type": "string",
      "format": "date",
      "description": "Data real de colheita"
    },
    "area_plantada_ha": {
      "type": "number",
      "description": "\u00c1rea plantada em hectares"
    },
    "populacao_plantas": {
      "type": "number",
      "description": "Popula\u00e7\u00e3o de plantas por hectare"
    },
    "espacamento_linha": {
      "type": "number",
      "description": "Espa\u00e7amento entre linhas (cm)"
    },
    "producao_estimada_kg": {
      "type": "number",
      "description": "Produ\u00e7\u00e3o estimada em kg"
    },
    "producao_real_kg": {
      "type": "number",
      "description": "Produ\u00e7\u00e3o real em kg"
    },
    "produtividade_sc_ha": {
      "type": "number",
      "description": "Produtividade em sc/ha"
    },
    "custo_total": {
      "type": "number",
      "description": "Custo total da \u00e1rea"
    },
    "custo_por_hectare": {
      "type": "number",
      "description": "Custo por hectare"
    },
    "receita_total": {
      "type": "number",
      "description": "Receita total"
    },
    "lucro_prejuizo": {
      "type": "number",
      "description": "Lucro ou preju\u00edzo"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pousio",
        "Prepara\u00e7\u00e3o",
        "Plantada",
        "Em Desenvolvimento",
        "Colheita",
        "Colhida"
      ],
      "default": "Pousio",
      "description": "Status da \u00e1rea"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "empresa_id",
    "area_id"
  ]
}
{
  "name": "FatorConsumoCategoria",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "categoria": {
      "type": "string",
      "description": "Nome da categoria do animal"
    },
    "fator": {
      "type": "number",
      "description": "Fator de consumo da categoria (ex: bezerro=0.5, vaca=1.0)"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do fator"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o fator est\u00e1 ativo"
    }
  },
  "required": [
    "empresa_id",
    "categoria",
    "fator"
  ]
}
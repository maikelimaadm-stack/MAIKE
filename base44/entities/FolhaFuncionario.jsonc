{
  "name": "FolhaFuncionario",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa/fazenda"
    },
    "nome_completo": {
      "type": "string",
      "description": "Nome completo do funcion\u00e1rio"
    },
    "cpf": {
      "type": "string",
      "description": "CPF do funcion\u00e1rio (exibir sempre mascarado na UI)"
    },
    "cargo": {
      "type": "string",
      "description": "Cargo/Fun\u00e7\u00e3o"
    },
    "salario_base": {
      "type": "number",
      "description": "Sal\u00e1rio base mensal"
    },
    "tipo_contrato": {
      "type": "string",
      "enum": [
        "CLT",
        "Autonomo"
      ],
      "default": "CLT",
      "description": "Tipo de contrato"
    },
    "jornada_mensal": {
      "type": "number",
      "default": 220,
      "description": "Jornada mensal de refer\u00eancia (horas)"
    },
    "dependentes_irrf": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de dependentes para IRRF"
    },
    "data_admissao": {
      "type": "string",
      "format": "date",
      "description": "Data de admiss\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Inativo"
      ],
      "default": "Ativo",
      "description": "Status do v\u00ednculo"
    },
    "dados_bancarios": {
      "type": "object",
      "properties": {
        "banco": {
          "type": "string"
        },
        "agencia": {
          "type": "string"
        },
        "conta": {
          "type": "string"
        },
        "pix": {
          "type": "string"
        },
        "tipo_conta": {
          "type": "string"
        }
      },
      "description": "Dados banc\u00e1rios (opcional)"
    }
  },
  "required": [
    "nome_completo",
    "cpf",
    "salario_base",
    "tipo_contrato"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "BebedouroHistorico",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa/fazenda"
    },
    "bebedouro_id": {
      "type": "string",
      "description": "ID do bebedouro"
    },
    "bebedouro_nome": {
      "type": "string",
      "description": "Nome do bebedouro"
    },
    "data_lancamento": {
      "type": "string",
      "format": "date",
      "description": "Data do lan\u00e7amento"
    },
    "hora_lancamento": {
      "type": "string",
      "description": "Hora do lan\u00e7amento"
    },
    "responsavel": {
      "type": "string",
      "description": "Respons\u00e1vel pelo lan\u00e7amento"
    },
    "tipo_lancamento": {
      "type": "string",
      "enum": [
        "Limpeza",
        "Tratamento da \u00e1gua",
        "Aplica\u00e7\u00e3o de produto",
        "Manuten\u00e7\u00e3o",
        "Vazamento",
        "Troca de boia",
        "Troca de encanamento",
        "An\u00e1lise da \u00e1gua",
        "Contamina\u00e7\u00e3o",
        "Inspe\u00e7\u00e3o",
        "Abastecimento",
        "Outro"
      ],
      "description": "Tipo do lan\u00e7amento"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada"
    },
    "produto_utilizado": {
      "type": "string",
      "description": "Produto utilizado"
    },
    "quantidade_utilizada": {
      "type": "number",
      "description": "Quantidade utilizada"
    },
    "custo": {
      "type": "number",
      "description": "Custo do lan\u00e7amento"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Fotos do lan\u00e7amento"
    },
    "anexos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Anexos do lan\u00e7amento"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pendente",
        "Conclu\u00eddo",
        "Emergencial"
      ],
      "default": "Conclu\u00eddo",
      "description": "Status do lan\u00e7amento"
    }
  },
  "required": [
    "empresa_id",
    "bebedouro_id",
    "data_lancamento",
    "tipo_lancamento",
    "status"
  ]
}
{
  "name": "LayoutTabelaColuna",
  "type": "object",
  "properties": {
    "layout_id": {
      "type": "string",
      "description": "ID do layout pai"
    },
    "column_id": {
      "type": "string",
      "description": "Identificador \u00fanico da coluna"
    },
    "entity_name": {
      "type": "string",
      "description": "Entidade vinculada"
    },
    "field_name": {
      "type": "string",
      "description": "Campo fixo ou chave din\u00e2mica"
    },
    "origem": {
      "type": "string",
      "enum": [
        "fixo",
        "customizado"
      ],
      "default": "fixo",
      "description": "Origem da coluna"
    },
    "label": {
      "type": "string",
      "description": "Nome da coluna"
    },
    "ordem": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "visivel": {
      "type": "boolean",
      "default": true,
      "description": "Se a coluna est\u00e1 vis\u00edvel"
    },
    "ordenavel": {
      "type": "boolean",
      "default": true,
      "description": "Se permite ordena\u00e7\u00e3o"
    },
    "filtravel": {
      "type": "boolean",
      "default": true,
      "description": "Se permite filtro din\u00e2mico"
    },
    "alinhamento": {
      "type": "string",
      "enum": [
        "left",
        "center",
        "right"
      ],
      "default": "left",
      "description": "Alinhamento da coluna"
    },
    "formato": {
      "type": "string",
      "description": "Formato de exibi\u00e7\u00e3o: date, number, currency etc."
    },
    "destaque": {
      "type": "boolean",
      "default": false,
      "description": "Se deve usar destaque visual"
    },
    "truncate": {
      "type": "boolean",
      "default": false,
      "description": "Se deve truncar texto longo"
    },
    "agrupavel": {
      "type": "boolean",
      "default": false,
      "description": "Prepara\u00e7\u00e3o para agrupamento futuro"
    },
    "regras": {
      "type": "object",
      "description": "Regras din\u00e2micas da coluna"
    },
    "metadata": {
      "type": "object",
      "description": "Configura\u00e7\u00f5es adicionais da coluna"
    }
  },
  "required": [
    "layout_id",
    "column_id",
    "entity_name",
    "field_name",
    "label",
    "ordem"
  ]
}
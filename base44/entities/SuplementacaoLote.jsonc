{
  "name": "SuplementacaoLote",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "suplementacao_evento_id": {
      "type": "string",
      "description": "ID do evento de suplementa\u00e7\u00e3o"
    },
    "lote_id": {
      "type": "string",
      "description": "ID do lote"
    },
    "lote_nome": {
      "type": "string",
      "description": "Nome do lote (cache)"
    },
    "categoria": {
      "type": "string",
      "description": "Categoria do lote"
    },
    "fator_consumo": {
      "type": "number",
      "description": "Fator de consumo da categoria (legado)"
    },
    "peso_medio_lote_kg": {
      "type": "number",
      "description": "Peso m\u00e9dio do lote no momento do lan\u00e7amento"
    },
    "consumo_esperado_pv_lote_kg": {
      "type": "number",
      "description": "Consumo esperado do lote via %PV (kg/dia)"
    },
    "data_lancamento": {
      "type": "string",
      "format": "date",
      "description": "Data do lan\u00e7amento (cache)"
    },
    "produto": {
      "type": "string",
      "description": "Produto fornecido (cache)"
    },
    "cabecas_na_area": {
      "type": "number",
      "description": "N\u00famero de cabe\u00e7as do lote na \u00e1rea durante o per\u00edodo"
    },
    "peso_consumo_lote": {
      "type": "number",
      "description": "Peso de consumo do lote (cabe\u00e7as x fator) - legado"
    },
    "dias_periodo": {
      "type": "number",
      "description": "Dias do per\u00edodo"
    },
    "consumo_unitario_dia": {
      "type": "number",
      "description": "Consumo unit\u00e1rio por dia"
    },
    "consumo_por_cabeca_dia_kg": {
      "type": "number",
      "description": "Consumo por cabe\u00e7a por dia em kg"
    },
    "consumo_total_lote_periodo_kg": {
      "type": "number",
      "description": "Consumo total do lote no per\u00edodo em kg"
    }
  },
  "required": [
    "empresa_id",
    "suplementacao_evento_id",
    "lote_id",
    "cabecas_na_area"
  ]
}
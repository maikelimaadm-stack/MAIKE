{
  "name": "Pesagem",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (vincula a pesagem a uma empresa)"
    },
    "numero_registro": {
      "type": "string",
      "description": "N\u00famero \u00fanico do registro (gerado automaticamente)"
    },
    "data_pesagem": {
      "type": "string",
      "format": "date",
      "description": "Data da pesagem"
    },
    "tipo_pesagem": {
      "type": "string",
      "enum": [
        "Entrada",
        "Sa\u00edda",
        "Ambos"
      ],
      "description": "Tipo de pesagem"
    },
    "placa_caminhao": {
      "type": "string",
      "description": "Placa do caminh\u00e3o"
    },
    "nome_motorista": {
      "type": "string",
      "description": "Nome do motorista"
    },
    "produto": {
      "type": "string",
      "description": "Produto/Insumo/Outros"
    },
    "fornecedor_destino": {
      "type": "string",
      "description": "Fornecedor ou Destino"
    },
    "peso_tara": {
      "type": "number",
      "description": "Peso Tara em kg"
    },
    "peso_bruto": {
      "type": "number",
      "description": "Peso Bruto em kg"
    },
    "peso_liquido": {
      "type": "number",
      "description": "Peso L\u00edquido em kg (calculado)"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre a pesagem"
    },
    "campos_personalizados": {
      "type": "object",
      "description": "Valores de campos personalizados e din\u00e2micos do registro"
    }
  },
  "required": [
    "empresa_id",
    "data_pesagem",
    "tipo_pesagem",
    "peso_tara",
    "peso_bruto"
  ]
}
{
  "name": "HistoricoLancamentoTarefa",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "tarefa_id": {
      "type": "string",
      "description": "ID da tarefa"
    },
    "titulo_tarefa": {
      "type": "string",
      "description": "T\u00edtulo da tarefa"
    },
    "evento": {
      "type": "string",
      "enum": [
        "Cria\u00e7\u00e3o",
        "Edi\u00e7\u00e3o",
        "Mudan\u00e7a de Local",
        "Mudan\u00e7a de Status",
        "Registro",
        "Conclus\u00e3o",
        "Cancelamento",
        "Coment\u00e1rio"
      ],
      "description": "Tipo do evento"
    },
    "data_evento": {
      "type": "string",
      "format": "date-time",
      "description": "Data do evento"
    },
    "status": {
      "type": "string",
      "description": "Status resultante do evento"
    },
    "responsavel": {
      "type": "string",
      "description": "Respons\u00e1vel da tarefa no evento"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do que aconteceu"
    }
  },
  "required": [
    "empresa_id",
    "tarefa_id",
    "evento",
    "data_evento"
  ]
}
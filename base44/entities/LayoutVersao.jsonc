{
  "name": "LayoutVersao",
  "type": "object",
  "properties": {
    "layout_id": {
      "type": "string",
      "description": "ID do layout principal"
    },
    "versao": {
      "type": "number",
      "description": "N\u00famero da vers\u00e3o"
    },
    "snapshot": {
      "type": "object",
      "description": "C\u00f3pia completa das se\u00e7\u00f5es, campos e colunas nesta vers\u00e3o"
    },
    "motivo": {
      "type": "string",
      "description": "Motivo da cria\u00e7\u00e3o da vers\u00e3o"
    },
    "ativo": {
      "type": "boolean",
      "default": false,
      "description": "Se esta vers\u00e3o est\u00e1 ativa"
    }
  },
  "required": [
    "layout_id",
    "versao",
    "snapshot"
  ]
}
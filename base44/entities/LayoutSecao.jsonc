{
  "name": "LayoutSecao",
  "type": "object",
  "properties": {
    "layout_id": {
      "type": "string",
      "description": "ID do layout pai"
    },
    "section_id": {
      "type": "string",
      "description": "Identificador \u00fanico da se\u00e7\u00e3o"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da se\u00e7\u00e3o"
    },
    "ordem": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "ativo": {

{
  "name": "MovimentacaoBancaria",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "numero_movimentacao": {
      "type": "string",
      "description": "N\u00famero \u00fanico da movimenta\u00e7\u00e3o (gerado automaticamente)"
    },
    "conta_bancaria_id": {
      "type": "string",
      "description": "ID da conta banc\u00e1ria"
    },
    "conta_bancaria_nome": {
      "type": "string",
      "description": "Nome da conta (cache)"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Entrada",
        "Sa\u00edda",
        "Transfer\u00eancia"
      ],
      "description": "Tipo de movimenta\u00e7\u00e3o"
    },
    "data_movimentacao": {
      "type": "string",
      "format": "date",
      "description": "Data da movimenta\u00e7\u00e3o"
    },
    "valor": {
      "type": "number",
      "description": "Valor da movimenta\u00e7\u00e3o"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da movimenta\u00e7\u00e3o"
    },
    "categoria": {
      "type": "string",
      "description": "Categoria da movimenta\u00e7\u00e3o"
    },
    "conta_destino_id": {
      "type": "string",
      "description": "ID da conta destino (para transfer\u00eancias)"
    },
    "lancamento_financeiro_id": {
      "type": "string",
      "description": "ID do lan\u00e7amento financeiro vinculado"
    },
    "conciliado": {
      "type": "boolean",
      "default": false,
      "description": "Se foi conciliado com extrato"
    },
    "data_conciliacao": {
      "type": "string",
      "format": "date",
      "description": "Data da concilia\u00e7\u00e3o"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "empresa_id",
    "conta_bancaria_id",
    "tipo",
    "data_movimentacao",
    "valor"
  ]
}
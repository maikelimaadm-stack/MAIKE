{
  "name": "CentroCusto",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "nome": {
      "type": "string",
      "description": "Nome do centro de custo"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Analitico",
        "Sintetico"
      ],
      "description": "Tipo: Anal\u00edtico (aceita lan\u00e7amentos) ou Sint\u00e9tico (agrupador)"
    },
    "centro_custo_pai_id": {
      "type": "string",
      "description": "ID do centro de custo pai para hierarquia"
    },
    "centro_custo_pai_nome": {
      "type": "string",
      "description": "Nome do centro de custo pai (cache)"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o opcional"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Status do centro de custo"
    },
    "ordem": {
      "type": "number",
      "description": "Ordem num\u00e9rica para exibi\u00e7\u00e3o"
    },
    "permite_lancamento_direto": {
      "type": "boolean",
      "default": true,
      "description": "Define se aceita lan\u00e7amentos diretos"
    }
  },
  "required": [
    "empresa_id",
    "nome",
    "tipo"
  ]
}
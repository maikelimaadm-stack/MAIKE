{
  "name": "FormPanel",
  "type": "object",
  "properties": {
    "layout_id": {
      "type": "string",
      "description": "ID do layout do formul\u00e1rio"
    },
    "panel_id": {
      "type": "string",
      "description": "Identificador l\u00f3gico do painel"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do painel/aba"
    },
    "ordem": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o painel est\u00e1 ativo"
    },
    "regras": {
      "type": "object",
      "description": "Regras condicionais do painel"
    },
    "metadata": {
      "type": "object",
      "description": "Configura\u00e7\u00f5es adicionais"
    }
  },
  "required": [
    "layout_id",
    "panel_id",
    "titulo",
    "ordem"
  ]
}
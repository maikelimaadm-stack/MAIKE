{
  "name": "SanidadeAnimal",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "configuracao_sanidade_id": {
      "type": "string",
      "description": "ID da configura\u00e7\u00e3o de sanidade usada"
    },
    "nome_sanidade": {
      "type": "string",
      "description": "Nome da sanidade (cache)"
    },
    "numero_animal": {
      "type": "string",
      "description": "N\u00famero do animal"
    },
    "data_aplicacao": {
      "type": "string",
      "format": "date",
      "description": "Data da aplica\u00e7\u00e3o"
    },
    "medicamento": {
      "type": "string",
      "description": "Nome do medicamento"
    },
    "finalidade": {
      "type": "string",
      "description": "Para que serve o medicamento"
    },
    "quantidade": {
      "type": "number",
      "description": "Quantidade aplicada"
    },
    "unidade_medida": {
      "type": "string",
      "description": "Unidade (ml, mg, etc)"
    },
    "custo_unitario": {
      "type": "number",
      "description": "Custo unit\u00e1rio do medicamento"
    },
    "custo_total": {
      "type": "number",
      "description": "Custo total calculado"
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "empresa_id",
    "numero_animal",
    "data_aplicacao",
    "medicamento"
  ]
}
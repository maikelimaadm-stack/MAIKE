{
  "name": "DocumentoEmbarque",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "embarque_id": {
      "type": "string",
      "description": "ID do embarque vinculado"
    },
    "embarque_nome": {
      "type": "string",
      "description": "Nome do embarque (cache)"
    },
    "tipo_documento": {
      "type": "string",
      "enum": [
        "GTA",
        "NF-e",
        "GTA+NF-e"
      ],
      "default": "GTA",
      "description": "Tipo do documento"
    },
    "numero_gta": {
      "type": "string",
      "description": "N\u00famero da GTA"
    },
    "numero_nfe": {
      "type": "string",
      "description": "N\u00famero da NF-e"
    },
    "motorista_nome": {
      "type": "string",
      "description": "Nome do motorista"
    },
    "placa_carreta": {
      "type": "string",
      "description": "Placa da carreta"
    },
    "qtd_prev_machos": {
      "type": "number",
      "default": 0,
      "description": "Quantidade prevista de machos"
    },
    "qtd_prev_femeas": {
      "type": "number",
      "default": 0,
      "description": "Quantidade prevista de f\u00eameas"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do documento"
    }
  },
  "required": [
    "empresa_id",
    "embarque_id"
  ]
}
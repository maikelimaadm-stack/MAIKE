{
  "name": "LocalEstoque",
  "type": "object",
  "properties": {
    "numero_local": {
      "type": "string",
      "description": "N\u00famero \u00fanico do local (gerado automaticamente)"
    },
    "nome": {
      "type": "string",
      "description": "Nome do local de estoque"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do local"
    },
    "capacidade": {
      "type": "string",
      "description": "Capacidade do local (opcional)"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o local est\u00e1 ativo"
    }
  },
  "required": [
    "nome"
  ]
}
{
  "name": "LivroFiscal",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "numero_registro": {
      "type": "string",
      "description": "N\u00famero \u00fanico do registro fiscal (gerado automaticamente)"
    },
    "tipo_livro": {
      "type": "string",
      "enum": [
        "Entrada",
        "Sa\u00edda",
        "Apura\u00e7\u00e3o ICMS",
        "Apura\u00e7\u00e3o IPI",
        "Invent\u00e1rio"
      ],
      "description": "Tipo do livro fiscal"
    },
    "tipo_documento": {
      "type": "string",
      "enum": [
        "NF-e",
        "NFC-e",
        "CT-e",
        "Recibo",
        "Cupom Fiscal",
        "Nota Manual",
        "Outros"
      ],
      "description": "Tipo do documento fiscal"
    },
    "numero_documento": {
      "type": "string",
      "description": "N\u00famero do documento"
    },
    "serie_documento": {
      "type": "string",
      "description": "S\u00e9rie do documento"
    },
    "chave_acesso": {
      "type": "string",
      "description": "Chave de acesso (44 d\u00edgitos para NF-e)"
    },
    "data_emissao": {
      "type": "string",
      "format": "date",
      "description": "Data de emiss\u00e3o do documento"
    },
    "data_entrada_saida": {
      "type": "string",
      "format": "date",
      "description": "Data de entrada ou sa\u00edda efetiva"
    },
    "fornecedor_id": {
      "type": "string",
      "description": "ID do fornecedor (para entradas)"
    },
    "fornecedor_nome": {
      "type": "string",
      "description": "Nome do fornecedor/emitente"
    },
    "fornecedor_cnpj_cpf": {
      "type": "string",
      "description": "CNPJ/CPF do fornecedor"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente (para sa\u00eddas)"
    },
    "cliente_cnpj_cpf": {
      "type": "string",
      "description": "CNPJ/CPF do cliente"
    },
    "cfop": {
      "type": "string",
      "description": "C\u00f3digo Fiscal de Opera\u00e7\u00f5es e Presta\u00e7\u00f5es"
    },
    "natureza_operacao": {
      "type": "string",
      "description": "Natureza da opera\u00e7\u00e3o"
    },
    "valor_produtos": {
      "type": "number",
      "description": "Valor total dos produtos"
    },
    "valor_frete": {
      "type": "number",
      "default": 0,
      "description": "Valor do frete"
    },
    "valor_seguro": {
      "type": "number",
      "default": 0,
      "description": "Valor do seguro"
    },
    "valor_desconto": {
      "type": "number",
      "default": 0,
      "description": "Valor de desconto"
    },
    "valor_outras_despesas": {
      "type": "number",
      "default": 0,
      "description": "Outras despesas acess\u00f3rias"
    },
    "valor_total_nota": {
      "type": "number",
      "description": "Valor total da nota fiscal"
    },
    "base_calculo_icms": {
      "type": "number",
      "default": 0,
      "description": "Base de c\u00e1lculo do ICMS"
    },
    "valor_icms": {
      "type": "number",
      "default": 0,
      "description": "Valor do ICMS"
    },
    "base_calculo_icms_st": {
      "type": "number",
      "default": 0,
      "description": "Base de c\u00e1lculo do ICMS ST"
    },
    "valor_icms_st": {
      "type": "number",
      "default": 0,
      "description": "Valor do ICMS ST"
    },
    "valor_ipi": {
      "type": "number",
      "default": 0,
      "description": "Valor do IPI"
    },
    "valor_pis": {
      "type": "number",
      "default": 0,
      "description": "Valor do PIS"
    },
    "valor_cofins": {
      "type": "number",
      "default": 0,
      "description": "Valor do COFINS"
    },
    "lancamento_financeiro_id": {
      "type": "string",
      "description": "ID do lan\u00e7amento financeiro vinculado"
    },
    "movimentacao_estoque_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs das movimenta\u00e7\u00f5es de estoque vinculadas"
    },
    "itens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "produto_id": {
            "type": "string"
          },
          "produto_nome": {
            "type": "string"
          },
          "codigo_produto": {
            "type": "string"
          },
          "ncm": {
            "type": "string"
          },
          "cfop": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          },
          "unidade": {
            "type": "string"
          },
          "valor_unitario": {
            "type": "number"
          },
          "valor_total": {
            "type": "number"
          },
          "base_icms": {
            "type": "number"
          },
          "aliquota_icms": {
            "type": "number"
          },
          "valor_icms": {
            "type": "number"
          },
          "aliquota_ipi": {
            "type": "number"
          },
          "valor_ipi": {
            "type": "number"
          }
        }
      },
      "description": "Itens do documento fiscal"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do registro fiscal"
    },
    "xml_url": {
      "type": "string",
      "description": "URL do arquivo XML (se aplic\u00e1vel)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Cancelado",
        "Inutilizado"
      ],
      "default": "Ativo",
      "description": "Status do documento fiscal"
    }
  },
  "required": [
    "empresa_id",
    "tipo_livro",
    "tipo_documento",
    "data_emissao",
    "valor_total_nota"
  ]
}
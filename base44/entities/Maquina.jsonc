{
  "name": "Maquina",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo interno do ativo"
    },
    "nome": {
      "type": "string",
      "description": "Nome/descri\u00e7\u00e3o do ativo"
    },
    "identificador_curto": {
      "type": "string",
      "description": "Identifica\u00e7\u00e3o curta do ativo"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "M\u00e1quina",
        "Equipamento",
        "Implemento",
        "Ve\u00edculo",
        "Ferramenta"
      ],
      "description": "Categoria do ativo"
    },
    "tipo_id": {
      "type": "string",
      "description": "ID do tipo de ativo"
    },
    "tipo": {
      "type": "string",
      "description": "Nome do tipo do ativo"
    },
    "marca": {
      "type": "string",
      "description": "Marca do ativo"
    },
    "modelo": {
      "type": "string",
      "description": "Modelo do ativo"
    },
    "ano_fabricacao": {
      "type": "number",
      "description": "Ano de fabrica\u00e7\u00e3o"
    },
    "placa": {
      "type": "string",
      "description": "Placa (se aplic\u00e1vel)"
    },
    "chassi": {
      "type": "string",
      "description": "N\u00famero do chassi"
    },
    "renavam": {
      "type": "string",
      "description": "Renavam (se aplic\u00e1vel)"
    },
    "potencia_cv": {
      "type": "number",
      "description": "Pot\u00eancia em CV"
    },
    "tipo_medicao": {
      "type": "string",
      "enum": [
        "Hor\u00edmetro",
        "Hod\u00f4metro",
        "Nenhum"
      ],
      "default": "Nenhum",
      "description": "Tipo de medi\u00e7\u00e3o utilizado no ativo"
    },
    "medicao_atual": {
      "type": "number",
      "description": "Medi\u00e7\u00e3o atual do ativo"
    },
    "data_aquisicao": {
      "type": "string",
      "format": "date",
      "description": "Data de aquisi\u00e7\u00e3o"
    },
    "valor_aquisicao": {
      "type": "number",
      "description": "Valor de aquisi\u00e7\u00e3o"
    },
    "valor_atual": {
      "type": "number",
      "description": "Valor atual estimado"
    },
    "vida_util_horas": {
      "type": "number",
      "description": "Vida \u00fatil estimada em horas"
    },
    "custo_hora": {
      "type": "number",
      "description": "Custo por hora de opera\u00e7\u00e3o"
    },
    "custo_depreciacao_hora": {
      "type": "number",
      "description": "Custo de deprecia\u00e7\u00e3o por hora"
    },
    "custo_manutencao_hora": {
      "type": "number",
      "description": "Custo m\u00e9dio de manuten\u00e7\u00e3o por hora"
    },
    "consumo_medio": {
      "type": "number",
      "description": "Consumo m\u00e9dio do ativo"
    },
    "valor_combustivel_litro": {
      "type": "number",
      "description": "Valor do combust\u00edvel por litro"
    },
    "capacidade_tanque": {
      "type": "number",
      "description": "Capacidade do tanque em litros"
    },
    "produtos_combustiveis_vinculados": {
      "type": "array",
      "description": "Produtos combust\u00edveis vinculados ao ativo",
      "items": {
        "type": "object",
        "properties": {
          "produto_id": {
            "type": "string"
          },
          "produto_nome": {
            "type": "string"
          },
          "principal": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "foto_url": {
      "type": "string",
      "description": "URL da foto do ativo"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "Em Manuten\u00e7\u00e3o",
        "Inativo",
        "Vendido"
      ],
      "default": "Ativo",
      "description": "Status do ativo"
    },
    "localizacao_atual": {
      "type": "string",
      "description": "Localiza\u00e7\u00e3o atual do ativo"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais"
    }
  },
  "required": [
    "empresa_id",
    "nome",
    "categoria",
    "tipo_medicao"
  ]
}
{
  "name": "Setor",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa principal"
    },
    "numero_setor": {
      "type": "string",
      "description": "N\u00famero \u00fanico do setor (gerado automaticamente)"
    },
    "nome": {
      "type": "string",
      "description": "Nome do setor/fazenda"
    },
    "sigla": {
      "type": "string",
      "description": "Sigla ou c\u00f3digo curto"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Pr\u00f3prio",
        "Arrendado",
        "Parceria",
        "Terceiros"
      ],
      "default": "Pr\u00f3prio",
      "description": "Tipo de propriedade/rela\u00e7\u00e3o"
    },
    "responsavel": {
      "type": "string",
      "description": "Nome do respons\u00e1vel"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone de contato"
    },
    "endereco": {
      "type": "string",
      "description": "Endere\u00e7o completo"
    },
    "cidade": {
      "type": "string",
      "description": "Cidade"
    },
    "estado": {
      "type": "string",
      "description": "Estado (UF)"
    },
    "area_total": {
      "type": "number",
      "description": "\u00c1rea total em hectares"
    },
    "capacidade_animais": {
      "type": "number",
      "description": "Capacidade m\u00e1xima de animais"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o setor est\u00e1 ativo"
    }
  },
  "required": [
    "empresa_id",
    "nome",
    "tipo"
  ]
}
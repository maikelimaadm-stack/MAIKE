      "type": "string",
      "description": "Produto usado no manejo sanit\u00e1rio"
    },
    "dose": {
      "type": "string",
      "description": "Dose aplicada"
    },
    "via_aplicacao": {
      "type": "string",
      "description": "Via de aplica\u00e7\u00e3o"
    },
    "duracao_tratamento": {
      "type": "string",
      "description": "Dura\u00e7\u00e3o do tratamento"
    },
    "lote_tratado": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do lote tratado"

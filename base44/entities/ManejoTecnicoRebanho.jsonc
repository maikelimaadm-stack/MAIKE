{
  "name": "ManejoTecnicoRebanho",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "data_evento": {
      "type": "string",
      "format": "date",
      "description": "Data do evento t\u00e9cnico"
    },
    "tipo_evento": {
      "type": "string",
      "enum": [
        "SANITARIO",
        "PESAGEM",
        "REPRODUCAO",
        "NUTRICIONAL",
        "AVALIACAO"
      ],
      "description": "Categoria t\u00e9cnica do evento"
    },
    "subtipo_manejo": {
      "type": "string",
      "description": "Subtipo do manejo realizado"
    },
    "lote_id": {
      "type": "string",
      "description": "ID do lote"
    },
    "nome_lote": {
      "type": "string",
      "description": "Nome do lote"
    },
    "categoria": {
      "type": "string",
      "description": "Categoria do lote"
    },
    "sexo": {
      "type": "string",
      "description": "Sexo do lote"
    },
    "quantidade_animais": {
      "type": "number",
      "description": "Quantidade de animais envolvidos"
    },
    "area_id": {
      "type": "string",
      "description": "ID da \u00e1rea atual do lote"
    },
    "nome_area": {
      "type": "string",
      "description": "Nome da \u00e1rea atual do lote"
    },
    "responsavel": {
      "type": "string",
      "description": "Respons\u00e1vel pelo manejo"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais"
    },

{
  "name": "Categoria",
  "type": "object",
  "properties": {
    "numero_categoria": {
      "type": "string",
      "description": "N\u00famero \u00fanico da categoria (gerado automaticamente)"
    },
    "nome": {
      "type": "string",
      "description": "Nome da categoria"
    },
    "categoria_pai_id": {
      "type": "string",
      "description": "ID da categoria pai para hierarquia"
    },
    "categoria_pai_nome": {
      "type": "string",
      "description": "Nome da categoria pai (cache)"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da categoria"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se a categoria est\u00e1 ativa"
    },
    "ordem": {
      "type": "number",
      "description": "Ordem num\u00e9rica para exibi\u00e7\u00e3o"
    }
  },
  "required": [

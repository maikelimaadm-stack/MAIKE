{
  "name": "Marca",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "numero_marca": {
      "type": "string",
      "description": "N\u00famero \u00fanico da marca (gerado automaticamente)"
    },
    "nome": {
      "type": "string",
      "description": "Nome da marca"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da marca"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se a marca est\u00e1 ativa"
    }
  },
  "required": [
    "empresa_id",
    "nome"
  ]
}
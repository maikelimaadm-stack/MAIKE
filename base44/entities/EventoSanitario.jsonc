{
  "name": "EventoSanitario",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa/fazenda"
    },
    "numero_evento": {
      "type": "string",
      "description": "N\u00famero \u00fanico do evento"
    },
    "tipo_evento": {
      "type": "string",
      "enum": [
        "Vacina\u00e7\u00e3o",
        "Vermifuga\u00e7\u00e3o",
        "Tratamento",
        "Insemina\u00e7\u00e3o",
        "Exame"
      ],
      "description": "Tipo do evento"
    },
    "data_evento": {
      "type": "string",
      "format": "date",
      "description": "Data do evento"
    },
    "animal_id": {
      "type": "string",
      "description": "ID do animal"
    },
    "lote": {
      "type": "string",
      "description": "Lote (para eventos em grupo)"
    },
    "produto_usado": {
      "type": "string",
      "description": "Produto/vacina usado"
    },
    "dosagem": {
      "type": "string",
      "description": "Dosagem aplicada"
    },
    "proxima_aplicacao": {
      "type": "string",
      "format": "date",
      "description": "Data da pr\u00f3xima aplica\u00e7\u00e3o"
    },
    "veterinario": {
      "type": "string",
      "description": "Veterin\u00e1rio respons\u00e1vel"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "empresa_id",
    "tipo_evento",
    "data_evento"
  ]
}
{
  "name": "BebedouroAnexo",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa/fazenda"
    },
    "bebedouro_id": {
      "type": "string",
      "description": "ID do bebedouro"
    },
    "historico_id": {
      "type": "string",
      "description": "ID do lan\u00e7amento vinculado, quando aplic\u00e1vel"
    },
    "sanidade_id": {
      "type": "string",
      "description": "ID da avalia\u00e7\u00e3o sanit\u00e1ria vinculada, quando aplic\u00e1vel"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Foto",
        "Anexo"
      ],
      "default": "Foto",
      "description": "Tipo do arquivo"
    },
    "nome": {
      "type": "string",
      "description": "Nome do arquivo"
    },
    "file_url": {
      "type": "string",
      "description": "URL do arquivo"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [

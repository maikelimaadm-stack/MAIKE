{
  "name": "LayoutCampo",
  "type": "object",
  "properties": {
    "layout_id": {
      "type": "string",
      "description": "ID do layout pai"
    },
    "section_id": {
      "type": "string",
      "description": "ID l\u00f3gico da se\u00e7\u00e3o"
    },
    "field_id": {
      "type": "string",
      "description": "Identificador \u00fanico do campo"
    },
    "entity_name": {
      "type": "string",
      "description": "Entidade vinculada"
    },
    "field_name": {
      "type": "string",
      "description": "Nome do campo fixo ou chave din\u00e2mica"
    },
    "origem": {
      "type": "string",
      "enum": [
        "fixo",
        "customizado"
      ],
      "default": "fixo",
      "description": "Origem do campo"
    },
    "label": {
      "type": "string",
      "description": "R\u00f3tulo do campo"
    },
    "placeholder": {
      "type": "string",
      "description": "Texto de placeholder"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o ou ajuda do campo"
    },
    "tipo": {
      "type": "string",
      "description": "Tipo de entrada: text, number, date, select, textarea, relation, calculado etc."
    },
    "col_span": {
      "type": "number",
      "default": 12,
      "description": "Tamanho no grid de 12 colunas, usado apenas no formul\u00e1rio"
    },
    "largura_coluna": {
      "type": "number",
      "default": 160,
      "description": "Largura da coluna na tabela em pixels"
    },
    "ordem": {
      "type": "number",
      "description": "Ordem dentro da se\u00e7\u00e3o/formul\u00e1rio"
    },
    "ordem_tabela": {
      "type": "number",
      "description": "Ordem espec\u00edfica da coluna na tabela"
    },
    "obrigatorio": {
      "type": "boolean",
      "default": false,
      "description": "Obrigatoriedade padr\u00e3o"
    },
    "read_only": {
      "type": "boolean",
      "default": false,
      "description": "Se o campo \u00e9 somente leitura"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o campo est\u00e1 ativo"
    },
    "visivel_form": {
      "type": "boolean",
      "default": true,
      "description": "Se aparece no formul\u00e1rio"
    },
    "visivel_tabela": {
      "type": "boolean",
      "default": false,
      "description": "Se aparece na tabela"
    },
    "visivel_relatorio": {
      "type": "boolean",
      "default": false,
      "description": "Se aparece em relat\u00f3rios"
    },
    "ordenavel": {
      "type": "boolean",
      "default": true,
      "description": "Se permite ordena\u00e7\u00e3o em tabela"
    },
    "filtravel": {
      "type": "boolean",
      "default": true,
      "description": "Se permite filtro em tabela"
    },
    "alinhamento": {
      "type": "string",
      "enum": [
        "left",
        "center",
        "right"
      ],
      "default": "left",
      "description": "Alinhamento da coluna"
    },
    "agregacao": {
      "type": "string",
      "enum": [
        "sum",
        "avg",
        "min",
        "max",
        "count"
      ],
      "description": "Tipo legado de agrega\u00e7\u00e3o"
    },
    "agregacao_tipo": {
      "type": "string",
      "enum": [
        "sum",
        "avg",
        "min",
        "max",
        "count"
      ],
      "description": "Tipo real de agrega\u00e7\u00e3o no rodap\u00e9 da tabela"
    },
    "agregacao_campo_base": {
      "type": "string",
      "description": "Campo base usado para agrega\u00e7\u00e3o quando diferente do pr\u00f3prio campo"
    },
    "usar_decimal": {
      "type": "boolean",
      "default": false,
      "description": "Se o campo deve aplicar formata\u00e7\u00e3o decimal"
    },
    "decimal_places": {
      "type": "number",
      "default": 2,
      "description": "Quantidade de casas decimais entre 0 e 6"
    },
    "usar_mascara": {
      "type": "boolean",
      "default": false,
      "description": "Se o campo num\u00e9rico deve aplicar m\u00e1scaras de entrada"
    },
    "mascaras_text": {
      "type": "string",
      "description": "M\u00e1scaras de entrada, uma por linha, usando # para n\u00fameros"
    },
    "calculation_builder": {
      "type": "object",
      "description": "Configura\u00e7\u00e3o visual do c\u00e1lculo criada pela interface guiada"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Op\u00e7\u00f5es est\u00e1ticas do campo select no formato {label,value}"
    },
    "options_source": {
      "type": "string",
      "description": "Fonte din\u00e2mica legada de op\u00e7\u00f5es relacionais"
    },
    "options_source_entity": {
      "type": "string",
      "description": "Entidade fonte para select din\u00e2mico"
    },
    "options_label_field": {
      "type": "string",
      "description": "Campo usado como label do select din\u00e2mico"
    },
    "options_value_field": {
      "type": "string",
      "description": "Campo usado como valor salvo do select din\u00e2mico"
    },
    "relation_entity": {
      "type": "string",
      "description": "Entidade relacionada para campos tipo relation"
    },
    "relation_display_field": {
      "type": "string",
      "description": "Campo exibido para campos tipo relation"
    },
    "regras": {
      "type": "object",
      "description": "Regras din\u00e2micas de visibilidade, valida\u00e7\u00e3o, autopreenchimento e c\u00e1lculo"
    },
    "formula": {
      "type": "string",
      "description": "F\u00f3rmula segura de c\u00e1lculo do campo"
    },
    "dependencias": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Campos dos quais este campo depende (legado)"
    },
    "campos_dependentes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Campos dependentes usados no c\u00e1lculo"
    },
    "uppercase": {
      "type": "boolean",
      "default": false,
      "description": "Se deve converter para caixa alta"
    },
    "step": {
      "type": "string",
      "description": "Incremento para campos num\u00e9ricos"
    },
    "rows": {
      "type": "number",
      "description": "Linhas para textarea"
    },
    "metadata": {
      "type": "object",
      "description": "Configura\u00e7\u00f5es auxiliares legadas/opcionais"
    }
  },
  "required": [
    "layout_id",
    "section_id",
    "field_id",
    "entity_name",
    "field_name",
    "label",
    "tipo",
    "ordem"
  ]
}
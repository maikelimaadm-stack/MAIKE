{
  "name": "ProdutoCotacao",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa"
    },
    "nome_produto": {
      "type": "string",
      "description": "Nome do produto"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "Verm\u00edfugo",
        "Vacina",
        "Pour-on",
        "Mineral",
        "Suplemento",
        "Antibi\u00f3tico",
        "Outros"
      ],
      "description": "Categoria do produto"
    },
    "funcao_tecnica": {
      "type": "string",
      "description": "Para que serve o produto"
    },
    "beneficios": {
      "type": "string",
      "description": "Benef\u00edcios diretos do produto"
    },
    "empresa_fornecedora": {
      "type": "string",
      "description": "Nome da empresa fornecedora"
    },
    "nome_vendedor": {
      "type": "string",
      "description": "Nome do vendedor"
    },
    "telefone_vendedor": {
      "type": "string",
      "description": "Telefone/WhatsApp do vendedor"
    },
    "valor_unitario": {
      "type": "number",
      "description": "Valor unit\u00e1rio do produto"
    },
    "quantidade_comprada": {
      "type": "number",
      "description": "Quantidade comprada"
    },
    "unidade_medida": {
      "type": "string",
      "default": "UN",
      "description": "Unidade de medida (UN, KG, LT, ML)"
    },
    "valor_total": {
      "type": "number",
      "description": "Valor total (c\u00e1lculo autom\u00e1tico)"
    },
    "data_cotacao": {
      "type": "string",
      "format": "date",
      "description": "Data da cota\u00e7\u00e3o"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es da cota\u00e7\u00e3o"
    }
  },
  "required": [
    "empresa_id",
    "nome_produto",
    "categoria",
    "empresa_fornecedora",
    "valor_unitario",
    "quantidade_comprada",
    "data_cotacao"
  ]
}
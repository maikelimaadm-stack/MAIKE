{
  "name": "GrupoAtividade",
  "type": "object",
  "properties": {
    "nome_grupo": {
      "type": "string",
      "description": "Nome do grupo"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do grupo"
    },
    "cor_icone": {
      "type": "string",
      "description": "Cor ou \u00edcone associado (opcional)"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [

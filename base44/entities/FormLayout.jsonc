{
  "name": "FormLayout",
  "type": "object",
  "properties": {
    "form_id": {
      "type": "string",
      "description": "Identificador \u00fanico do formul\u00e1rio"
    },
    "entity_name": {
      "type": "string",
      "description": "Entidade principal do formul\u00e1rio"
    },
    "nome": {
      "type": "string",
      "description": "Nome do layout"
    },
    "escopo": {
      "type": "string",
      "enum": [
        "sistema",
        "empresa",
        "usuario"
      ],
      "default": "sistema",
      "description": "Escopo do layout"
    },
    "empresa_id": {
      "type": "string",
      "description": "Empresa vinculada quando aplic\u00e1vel"
    },
    "user_email": {
      "type": "string",
      "description": "Usu\u00e1rio vinculado quando aplic\u00e1vel"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o layout est\u00e1 ativo"
    },
    "metadata": {
      "type": "object",
      "description": "Configura\u00e7\u00f5es adicionais"
    }
  },
  "required": [
    "form_id",
    "entity_name",
    "nome",
    "escopo"
  ]
}
{
  "name": "LayoutVersao",
  "type": "object",
  "properties": {
    "layout_id": { "type": "string", "description": "ID do layout principal" },
    "versao": { "type": "number", "description": "Número da versão" },
    "snapshot": { "type": "object", "description": "Cópia completa das seções, campos e colunas nesta versão" },
    "motivo": { "type": "string", "description": "Motivo da criação da versão" },
    "ativo": { "type": "boolean", "default": false, "description": "Se esta versão está ativa" }
  },
  "required": ["layout_id", "versao", "snapshot"]
}
{
  "name": "CampoPersonalizado",
  "type": "object",
  "properties": {
    "entity_name": { "type": "string", "description": "Entidade onde o campo será aplicado" },
    "field_id": { "type": "string", "description": "Identificador único do campo" },
    "field_name": { "type": "string", "description": "Chave usada no JSON de campos personalizados" },
    "label": { "type": "string", "description": "Nome exibido ao usuário" },
    "tipo": { "type": "string", "description": "Tipo do campo" },
    "empresa_id": { "type": "string", "description": "Empresa vinculada, quando aplicável" },
    "user_email": { "type": "string", "description": "Usuário vinculado, quando aplicável" },
    "ativo": { "type": "boolean", "default": true, "description": "Se o campo está ativo" },
    "regras": { "type": "object", "description": "Regras de validação, visibilidade e cálculo" },
    "metadata": { "type": "object", "description": "Configurações adicionais" }
  },
  "required": ["entity_name", "field_id", "field_name", "label", "tipo"]
}
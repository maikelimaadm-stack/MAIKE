{
  "name": "LayoutCampo",
  "type": "object",
  "properties": {
    "layout_id": { "type": "string", "description": "ID do layout pai" },
    "section_id": { "type": "string", "description": "ID lógico da seção" },
    "field_id": { "type": "string", "description": "Identificador único do campo" },
    "entity_name": { "type": "string", "description": "Entidade vinculada" },
    "field_name": { "type": "string", "description": "Nome do campo fixo ou chave dinâmica" },
    "origem": { "type": "string", "enum": ["fixo", "customizado"], "default": "fixo", "description": "Origem do campo" },
    "label": { "type": "string", "description": "Rótulo do campo" },
    "tipo": { "type": "string", "description": "Tipo de entrada: text, number, date, select, textarea, readonlyNumber etc." },
    "col_span": { "type": "number", "default": 12, "description": "Tamanho no grid de 12 colunas" },
    "ordem": { "type": "number", "description": "Ordem dentro da seção" },
    "obrigatorio": { "type": "boolean", "default": false, "description": "Obrigatoriedade padrão" },
    "ativo": { "type": "boolean", "default": true, "description": "Se o campo aparece no layout" },
    "placeholder": { "type": "string", "description": "Texto de placeholder" },
    "uppercase": { "type": "boolean", "default": false, "description": "Se deve converter para caixa alta" },
    "read_only": { "type": "boolean", "default": false, "description": "Se o campo é somente leitura" },
    "step": { "type": "string", "description": "Incremento para campos numéricos" },
    "rows": { "type": "number", "description": "Linhas para textarea" },
    "options": { "type": "array", "items": { "type": "object" }, "description": "Opções estáticas do campo" },
    "options_source": { "type": "string", "description": "Fonte dinâmica de opções" },
    "regras": { "type": "object", "description": "Regras dinâmicas: visibilidade, obrigatoriedade, cálculo, dependências" },
    "metadata": { "type": "object", "description": "Configurações adicionais do campo" }
  },
  "required": ["layout_id", "section_id", "field_id", "entity_name", "field_name", "label", "tipo", "ordem"]
}
{
  "name": "AreaPastagem",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa/fazenda"
    },
    "setor_id": {
      "type": "string",
      "description": "ID do setor vinculado"
    },
    "setor_nome": {
      "type": "string",
      "description": "Nome do setor vinculado"
    },
    "numero_area": {
      "type": "string",
      "description": "Número único da área"
    },
    "nome": {
      "type": "string",
      "description": "Nome da área/piquete/infraestrutura"
    },
    "sigla": {
      "type": "string",
      "description": "Sigla da área"
    },
    "tamanho_hectares": {
      "type": "number",
      "description": "Tamanho total em hectares"
    },
    "area_pastejada": {
      "type": "number",
      "description": "Área efetiva/produtiva em hectares"
    },
    "capacidade_maxima": {
      "type": "number",
      "description": "Capacidade máxima de animais (UA)"
    },
    "tipo_pastagem": {
      "type": "string",
      "description": "Tipo de pastagem ou cultura"
    },
    "aproveitamento_classificacao": {
      "type": "string",
      "enum": ["Alta", "Média", "Baixa"],
      "default": "Média",
      "description": "Classificação de aproveitamento da área"
    },
    "tipo_cultura": {
      "type": "string",
      "enum": ["Pastagem", "Agricultura", "Reserva", "APP", "Infraestrutura"],
      "default": "Pastagem",
      "description": "Tipo de uso da área"
    },
    "tipo_infraestrutura": {
      "type": "string",
      "enum": ["Curral", "Oficina", "Casa", "Barracão", "Galpão", "Depósito", "Embarcador", "Brete", "Outro"],
      "description": "Tipo da infraestrutura"
    },
    "cor": {
      "type": "string",
      "description": "Cor preferida para exibição no mapa"
    },
    "quantidade_atual": {
      "type": "number",
      "default": 0,
      "description": "Quantidade atual de animais"
    },
    "status_ocupacao": {
      "type": "string",
      "enum": ["Disponível", "Médio", "Alto", "Sobrepastoreado"],
      "default": "Disponível",
      "description": "Status de ocupação"
    },
    "forragem_kg_ha": {
      "type": "number",
      "description": "Forragem disponível estimada"
    },
    "taxa_crescimento_kg_ha_dia": {
      "type": "number",
      "description": "Taxa de crescimento do capim"
    },
    "taxa_aproveitamento": {
      "type": "number",
      "description": "Taxa de aproveitamento da pastagem"
    },
    "periodo_estacao": {
      "type": "string",
      "enum": ["Seco", "Intermediário", "Chuvoso"],
      "description": "Período da pastagem"
    },
    "coordenadas": {
      "type": "object",
      "description": "Coordenadas do polígono no mapa"
    },
    "observacoes": {
      "type": "string",
      "description": "Observações sobre a área"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se a área está ativa"
    }
  },
  "required": ["empresa_id", "setor_id", "setor_nome", "nome"]
}
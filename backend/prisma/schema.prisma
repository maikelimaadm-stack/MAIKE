// ModeloBase1 Pecuário — fundação de tenant (P3) + capacidades migradas (P4+).
//
// Este schema implementa EXATAMENTE o contrato de
// `config/modelobase1-pecuario.json`.
//
// A P3 criou só a fundação — `Cliente`, `Usuario`, `AuditLog`,
// `EntidadeCodigoSequencia`, `RegistroAnexo` — e nenhum model de domínio, por
// não haver consumidor migrado. A partir da P4 cada capacidade entra **uma por
// missão**, quando existe consumidor real: a P4.1 traz `Setor` (D-PROD-25).
// `AreaPastagem` e o resto da geografia continuam na Base44 até a P4.2 — o
// schema não antecipa model sem consumidor.
//
// Invariantes travadas por `gate:tenancy` e `gate:indices`:
//
//   identidade   id String @id @default(cuid()); nunca vem do cliente HTTP
//   tenancy      cliente_id obrigatório em todo model tenant-scoped;
//                `Cliente` é a raiz e a única exceção (D-PROD-22)
//   unique       toda chave de negócio inclui cliente_id
//   índice       todo índice tenant-scoped começa por cliente_id
//   timestamps   createdAt e updatedAt em todo model persistente

// Sem `output` explícito: o Prisma resolve para o `node_modules` onde
// `@prisma/client` está instalado — a raiz do repositório. As dependências do
// backend vivem no `package.json` raiz, num lockfile só, para que
// `gate:package-sync` continue enxergando todas elas.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Cliente — raiz estrutural do tenant.
//
// Único model sem `cliente_id`, porque ele É o tenant: `Cliente.id` é a
// identidade da raiz de tenancy (D-PROD-22). Criar `cliente_id` autorreferente
// aqui é explicitamente proibido.
//
// `codigo` é o identificador operacional usado no login — identidade de
// negócio, nunca chave primária. Como `Cliente` não é tenant-scoped, o unique
// dele é global por definição.
// ---------------------------------------------------------------------------
model Cliente {
  id        String   @id @default(cuid())
  codigo    String   @unique @db.VarChar(64)
  nome      String   @db.VarChar(255)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios   Usuario[]
  auditLogs  AuditLog[]
  sequencias EntidadeCodigoSequencia[]
  anexos     RegistroAnexo[]
  setores    Setor[]

  @@index([nome])
  @@index([ativo])
}

// ---------------------------------------------------------------------------
// Usuario — tenant-scoped.
//
// Mínimo necessário para autenticação própria. Sem Empresa, sem permissões,
// sem perfil empresarial, sem acesso_global: nada disso tem consumidor na P3.
//
// `senha_hash` é o único vestígio da senha. A senha pura nunca é persistida e
// nunca entra no AuditLog.
//
// `onDelete: Restrict` — apagar um Cliente que ainda tem usuários falha. A
// exclusão de Cliente é política explícita e revisada, nunca cascade acidental
// (contrato: `tenancy.clienteDeletePolicy = "explicit-reviewed"`).
// ---------------------------------------------------------------------------
model Usuario {
  id         String   @id @default(cuid())
  cliente_id String   @db.VarChar(64)
  nome       String   @db.VarChar(255)
  login      String   @db.VarChar(120)
  senha_hash String   @db.VarChar(255)
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cliente   Cliente    @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  auditLogs AuditLog[]

  @@unique([cliente_id, login])
  // Chave referenciável tenant-aware. Existe para que quem aponta para um
  // Usuario aponte para "este usuário DENTRO deste cliente", e não para um id
  // solto que poderia pertencer a outro tenant. Ver AuditLog.
  @@unique([cliente_id, id])
  @@index([cliente_id, ativo])
}

// ---------------------------------------------------------------------------
// AuditLog — camada B da auditoria (a camada A são os timestamps por model).
//
// Diverge do PROJETOMG de propósito: lá `cliente_id` é nullable com
// `onDelete: SetNull`. Aqui ele é OBRIGATÓRIO — log de auditoria sem tenant não
// é auditável num sistema multi-tenant.
//
// `usuario_id` é opcional e ausente SOMENTE em evento de sistema. Por isso a
// relação com Usuario é `Restrict` e não `SetNull`: anular o ator faria um
// evento humano passar por evento de sistema, e o rastro mentiria.
//
// `dados_anteriores` e `dados_novos` nunca recebem senha, credencial, segredo
// ou conteúdo binário — a filtragem vive em `auditService`.
// ---------------------------------------------------------------------------
model AuditLog {
  id               String   @id @default(cuid())
  cliente_id       String   @db.VarChar(64)
  usuario_id       String?  @db.VarChar(64)
  acao             String   @db.VarChar(64)
  entidade         String   @db.VarChar(128)
  entidade_id      String?  @db.VarChar(128)
  dados_anteriores Json?
  dados_novos      Json?
  request_id       String   @db.VarChar(64)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Restrict)

  // FK COMPOSTA, tenant-aware. Aponta para [cliente_id, id] de Usuario, não
  // para o id solto.
  //
  // Com duas FKs independentes — cliente_id -> Cliente.id e usuario_id ->
  // Usuario.id — o banco aceitaria um AuditLog do Cliente A com ator do Cliente
  // B. O service nunca monta esse objeto, porque tenant e ator saem do mesmo
  // auth_context; mas o contrato declara `crossTenantRelationsAllowed = false`
  // e manda a constraint ser a última barreira. Regra que depende de o service
  // estar certo não é barreira, é convenção.
  //
  // `usuario_id` continua opcional para evento de sistema. O PostgreSQL usa
  // MATCH SIMPLE por padrão: com qualquer coluna da FK composta nula, a
  // verificação é dispensada — então `usuario_id = NULL` passa, que é
  // exatamente o comportamento desejado.
  usuario Usuario? @relation(fields: [cliente_id, usuario_id], references: [cliente_id, id], onDelete: Restrict)

  @@index([cliente_id, createdAt])
  @@index([cliente_id, entidade, entidade_id])
  @@index([cliente_id, usuario_id])
  @@index([cliente_id, request_id])
}

// ---------------------------------------------------------------------------
// EntidadeCodigoSequencia — numeração atômica.
//
// `escopo_id` é String NÃO NULA, por decisão da P3. No PostgreSQL, NULL nunca é
// igual a NULL num índice unique: com `escopo_id` nullable, duas linhas de
// sequência para a mesma entidade coexistiriam e distribuiriam números em
// paralelo — o unique não barraria nada, e o sintoma só apareceria sob
// concorrência.
//
// Sentinela: no escopo `tenant`, `escopo_id` recebe o próprio `cliente_id`.
// No escopo `empresa`, receberá o ID real da Empresa quando essa capacidade
// existir (P4–P6). A P3 suporta os dois tipos e NÃO decide qual entidade usa
// qual.
//
// A reserva é `UPDATE … RETURNING` dentro de transação. Nunca MAX+1, nunca
// COUNT(*)+1.
// ---------------------------------------------------------------------------
model EntidadeCodigoSequencia {
  id            String   @id @default(cuid())
  cliente_id    String   @db.VarChar(64)
  entidade      String   @db.VarChar(128)
  escopo_tipo   String   @db.VarChar(32)
  escopo_id     String   @db.VarChar(64)
  proximo_valor Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Restrict)

  @@unique([cliente_id, entidade, escopo_tipo, escopo_id])
  @@index([cliente_id, entidade])
}

// ---------------------------------------------------------------------------
// RegistroAnexo — registro genérico de anexo, independente de provider.
//
// `storage_key` é a IDENTIDADE persistente do objeto. URL pública é efêmera e
// nunca identidade — é por isso que não existe campo `file_url` aqui.
//
// Nenhum binário no PostgreSQL. `mime_type` e `tamanho_bytes` são validados no
// backend; `nome_original` é sanitizado antes de persistir.
//
// A P3 NÃO escolhe provedor de storage. `storage_key` é opaca de propósito.
// ---------------------------------------------------------------------------
model RegistroAnexo {
  id            String   @id @default(cuid())
  cliente_id    String   @db.VarChar(64)
  entidade      String   @db.VarChar(128)
  entidade_id   String   @db.VarChar(128)
  nome_original String   @db.VarChar(255)
  storage_key   String   @db.VarChar(1024)
  mime_type     String   @db.VarChar(255)
  tamanho_bytes Int
  checksum      String?  @db.VarChar(128)
  criado_por    String   @db.VarChar(64)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Restrict)

  @@unique([cliente_id, storage_key])
  @@index([cliente_id, entidade, entidade_id])
  @@index([cliente_id, createdAt])
}

// ---------------------------------------------------------------------------
// Setor — primeira capacidade de domínio migrada da Base44 (P4.1, D-PROD-25).
//
// `numero_setor` é identificador de NEGÓCIO, nunca linha: a chave primária
// continua sendo `id`/`cuid()`. Ele é atribuído por `EntidadeCodigoSequencia`
// no escopo `tenant`, dentro da mesma transação da criação — o `MAX + 1` que o
// frontend fazia some com esta missão. Escopo `tenant` e não `empresa` porque
// `Empresa` ainda não é model nativo (P6): numerar por empresa exigiria uma
// chave de escopo que o backend não consegue validar hoje, e uma sequência
// ancorada em id não verificável é pior que uma sequência mais larga.
//
// `empresa_id` é String simples, SEM relação Prisma, exatamente por isso. Ele
// carrega o valor que a Base44 já gravava, para que o filtro por empresa que a
// tela faz continue funcionando. Vira FK real quando `Empresa` for nativa.
//
// `ativo` é campo de negócio herdado do cadastro — NÃO é soft delete
// disfarçado. O contrato proíbe `ativoFieldReplacesDeletionPolicy`, e a P4.1
// não expõe exclusão: não existe `DELETE /setores/:id` (ver setorRoutes.js).
//
// `@@unique([cliente_id, id])` é a chave referenciável tenant-aware. Nada
// aponta para Setor ainda; ela existe para que a FK composta de `AreaPastagem`
// (P4.2) possa nascer tenant-aware sem migration de retrofit — o mesmo motivo
// pelo qual `Usuario` a declara desde a P3.
// ---------------------------------------------------------------------------
model Setor {
  id                 String   @id @default(cuid())
  cliente_id         String   @db.VarChar(64)
  empresa_id         String   @db.VarChar(64)
  numero_setor       String   @db.VarChar(32)
  nome               String   @db.VarChar(255)
  sigla              String?  @db.VarChar(32)
  // `default: "Próprio"` vem do contrato legado (`base44/entities/Setor.jsonc`).
  // A P4.1 trouxe o enum e a obrigatoriedade e deixou o default para trás; a
  // P4.1-R2 fecha isso com migration aditiva. Não torna o campo opcional na
  // API — ver D-PROD-25 §M.
  tipo               String   @default("Próprio") @db.VarChar(32)
  responsavel        String?  @db.VarChar(255)
  telefone           String?  @db.VarChar(64)
  endereco           String?  @db.VarChar(255)
  cidade             String?  @db.VarChar(255)
  estado             String?  @db.VarChar(8)
  area_total         Decimal? @db.Decimal(14, 4)
  capacidade_animais Int?
  observacoes        String?  @db.VarChar(2000)
  ativo              Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Restrict)

  @@unique([cliente_id, numero_setor])
  @@unique([cliente_id, id])
  @@index([cliente_id, empresa_id])
  @@index([cliente_id, ativo])
  @@index([cliente_id, nome])
}

  grupo_atividade_nome   String?   @db.VarChar(255)
  solicitante            String?   @db.VarChar(255)
  data_pedido            DateTime? @db.Date
  setor_nome             String?   @db.VarChar(255)
  prioridade             String    @default("Média") @db.VarChar(32)
  status                 String    @default("Pendente") @db.VarChar(32)
  data_prevista          DateTime? @db.Date
  data_inicio            DateTime?
  data_conclusao         DateTime? @db.Date
  area_id                String?   @db.VarChar(64)
  area_nome              String?   @db.VarChar(255)
  lote_id                String?   @db.VarChar(64)
  lote_nome              String?   @db.VarChar(255)
  ponto_suplementacao_id String?   @db.VarChar(64)
  coordenadas            Json?
  responsavel_id         String?   @db.VarChar(64)
  responsavel            String?   @db.VarChar(255)
  responsavel_geral      String?   @db.VarChar(255)
  observacoes            String?   @db.VarChar(2000)
  observacoes_conclusao  String?   @db.VarChar(2000)
  fotos                  String[]  @default([])
  anexos_urls            String[]  @default([])
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  cliente  Cliente         @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  tipoTarefa TipoTarefa    @relation(fields: [cliente_id, tipo_tarefa_id], references: [cliente_id, id], onDelete: Restrict)
  grupo    GrupoAtividade? @relation(fields: [cliente_id, grupo_atividade_id], references: [cliente_id, id], onDelete: Restrict)
  lote     Lote?           @relation(fields: [cliente_id, lote_id], references: [cliente_id, id], onDelete: Restrict)
  area     AreaPastagem?   @relation(fields: [cliente_id, area_id], references: [cliente_id, id], onDelete: Restrict)
  historicos HistoricoLancamentoTarefa[]

  @@unique([cliente_id, id])
  @@index([cliente_id, empresa_id])
  @@index([cliente_id, tipo_tarefa_id])
  @@index([cliente_id, grupo_atividade_id])
  @@index([cliente_id, lote_id])
  @@index([cliente_id, area_id])
  @@index([cliente_id, status])
  @@index([cliente_id, updatedAt])
}


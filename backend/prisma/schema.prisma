// ---------------------------------------------------------------------------
// LancamentoTarefa — manejo georreferenciado (P5.3, D-PROD-49).
//
// FK composta para TipoTarefa (obrigatório). Lote, área e grupo opcionais;
// caches denormalizados derivados na escrita. `ponto_suplementacao_id` permanece
// opaco — PontoSuplementacao ainda é Base44.
// ---------------------------------------------------------------------------
model LancamentoTarefa {
  id                     String    @id @default(cuid())
  cliente_id             String    @db.VarChar(64)
  empresa_id             String    @db.VarChar(64)
  titulo                 String    @db.VarChar(255)
  descricao              String?   @db.VarChar(2000)

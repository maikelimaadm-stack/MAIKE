  marca                     String?  @db.VarChar(255)
  descricao                 String?  @db.VarChar(2000)
  unidade_medida            String?  @db.VarChar(32)
  preco_custo               Decimal? @db.Decimal(14, 4)
  preco_venda               Decimal? @db.Decimal(14, 4)
  estoque_atual             Decimal  @default(0) @db.Decimal(14, 4)
  estoque_minimo            Decimal  @default(0) @db.Decimal(14, 4)
  local_estoque             String?  @db.VarChar(255)
  tipo_consumo              String?  @db.VarChar(32)
  percentual_consumo_pv     Decimal? @db.Decimal(14, 6)
  consumo_minimo_pv         Decimal? @db.Decimal(14, 6)
  consumo_maximo_pv         Decimal? @db.Decimal(14, 6)
  unidade_principal_estoque String   @default("KG") @db.VarChar(16)
  peso_por_saco_kg          Decimal? @db.Decimal(14, 4)
  observacoes               String?  @db.VarChar(2000)
  ativo                     Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  // D-PROD-155 — itens de lançamento deste produto.
  itensFinanceiros OperacaoFinanceiraItem[]

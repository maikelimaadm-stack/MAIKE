model AuditoriaCatalogoGlobal {
  id          String   @id @default(cuid())
  operador_id String?  @db.VarChar(64)
  acao        String   @db.VarChar(64)
  entidade    String   @db.VarChar(64)
  entidade_id String?  @db.VarChar(64)
  dados       Json?
  request_id  String   @db.VarChar(128)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Ator desde a R3 (D-PROD-70). Registros antigos mantêm só `operador_id`.
  admin_id    String?  @db.VarChar(64)

  operador OperadorProdutoMaike? @relation(fields: [operador_id], references: [id], onDelete: Restrict)
  admin    AdminPrincipalMaike?  @relation(fields: [admin_id], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([entidade, entidade_id])
  @@index([admin_id, createdAt])
}

/// Identidade do PRODUTO MAIKE (D-PROD-70): sem cliente_id/empresa_id, não é
/// Usuario de tenant e não acessa dados de tenants. Administra só o catálogo
/// global oficial e a própria segurança.
model AdminPrincipalMaike {
  id                  String    @id @default(cuid())
  login               String    @unique @db.VarChar(120)
  papel               String    @default("proprietario") @db.VarChar(32)
  /// Igual a "proprietario" em exatamente uma linha: o bootstrap é único.
  chave_proprietario  String?   @unique @db.VarChar(32)
  /// scrypt versionado (`scrypt$1$N$r$p$salt$hash`); nunca texto.
  senha_hash          String    @db.VarChar(255)
  /// Segredo TOTP cifrado (AES-256-GCM, chave server-only).
  mfa_segredo_cifrado String?   @db.VarChar(512)
  mfa_ativo           Boolean   @default(false)
  /// Último passo TOTP aceito — impede reuso do mesmo código.
  mfa_ultimo_passo    Int?
  tentativas_falhas   Int       @default(0)
  bloqueado_ate       DateTime?
  senha_alterada_em   DateTime?
  ativo               Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessoes            SessaoAdminMaike[]
  codigosRecuperacao CodigoRecuperacaoAdminMaike[]
  eventosSeguranca   EventoSegurancaAdminMaike[]
  auditoriasCatalogo AuditoriaCatalogoGlobal[]
}

/// Sessão opaca do MAIKE Admin: só o sha256 do token fica no banco.
model SessaoAdminMaike {
  id               String    @id @default(cuid())
  admin_id         String    @db.VarChar(64)
  token_hash       String    @unique @db.VarChar(64)
  mfa_verificado   Boolean   @default(false)
  tentativas_mfa   Int       @default(0)
  expira_em        DateTime
  ultimo_uso_em    DateTime  @default(now())
  revogada_em      DateTime?
  motivo_revogacao String?   @db.VarChar(64)
  ip               String?   @db.VarChar(64)
  user_agent       String?   @db.VarChar(255)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  admin AdminPrincipalMaike @relation(fields: [admin_id], references: [id], onDelete: Restrict)

  @@index([admin_id, revogada_em])
  @@index([expira_em])
}

/// Códigos de recuperação de MFA: só o hash; uso único.
model CodigoRecuperacaoAdminMaike {
  id          String    @id @default(cuid())
  admin_id    String    @db.VarChar(64)
  codigo_hash String    @unique @db.VarChar(64)
  usado_em    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  admin AdminPrincipalMaike @relation(fields: [admin_id], references: [id], onDelete: Restrict)

  @@index([admin_id, usado_em])
}

/// Trilha de segurança do MAIKE Admin (login, MFA, troca de senha/login, sessões).
model EventoSegurancaAdminMaike {
  id         String   @id @default(cuid())
  admin_id   String?  @db.VarChar(64)
  acao       String   @db.VarChar(64)
  sucesso    Boolean
  ip         String?  @db.VarChar(64)
  request_id String   @db.VarChar(128)
  dados      Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  admin AdminPrincipalMaike? @relation(fields: [admin_id], references: [id], onDelete: Restrict)

  @@index([admin_id, createdAt])
  @@index([createdAt])
}

// ─── R2E-P1 (D-PROD-107): ledger do rebanho por posição ───────────────────
//
// Três responsabilidades, uma fonte de verdade por empresa ATIVADA:
//  - `Lote` = cadastro de ENTRADA (fato histórico; não recebe saldo nem área
//    de movimento depois da ativação);
//  - `EventoRebanho` + `PartidaRebanho` = ledger AUTORITATIVO: cada fato com
//    data operacional (dia) e deltas por posição;
//  - `PosicaoRebanho` = projeção do saldo atual (soma das partidas ativas),
//    reconstruível e verificada pelo motor.
// Empresa sem `RebanhoLedgerAtivacao` segue no modelo legado (fase expand).

/// Ativação do ledger por empresa: a partir do corte, o saldo operacional mora
/// nas posições. Antes do corte, o histórico legado é "saldo de abertura".
model RebanhoLedgerAtivacao {
  id                     String   @id @default(cuid())
  cliente_id             String   @db.VarChar(64)
  empresa_id             String   @db.VarChar(64)
  data_corte             DateTime @db.Date
  /// 'saldo_abertura' (corte = saldo atual legado) ou 'entradas' (linha do tempo reconstruída desde cada entrada).
  modo                   String   @default("saldo_abertura") @db.VarChar(32)
  ativado_por_usuario_id String?  @db.VarChar(64)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  empresa Empresa @relation(fields: [cliente_id, empresa_id], references: [cliente_id, id], onDelete: Restrict)

  @@unique([cliente_id, empresa_id])
  @@unique([cliente_id, id])
}

/// Posição operacional: animais de UMA linhagem de entrada, numa área, numa
/// classificação (categoria + sexo + categoria de manejo). A mesma entrada
/// pode ter posições em várias áreas. Identidade = `chave_identidade`.
model PosicaoRebanho {
  id                    String   @id @default(cuid())
  cliente_id            String   @db.VarChar(64)
  empresa_id            String   @db.VarChar(64)
  area_id               String   @db.VarChar(64)
  lote_entrada_id       String?  @db.VarChar(64)
  /// Composição de entradas (junção futura): [{lote_id, nome, numero_lote}].
  linhagem              Json     @default("[]")
  chave_identidade      String   @db.VarChar(512)
  nome                  String   @db.VarChar(255)
  numero_lote           String?  @db.VarChar(64)
  categoria             String?  @db.VarChar(128)
  categoria_manejo_id   String?  @db.VarChar(64)
  categoria_manejo_nome String?  @db.VarChar(255)
  sexo                  String?  @db.VarChar(32)
  peso_medio_kg         Decimal? @db.Decimal(14, 4)
  quantidade_cabecas    Int      @default(0)
  identificador_nome    String?  @db.VarChar(255)
  identificador_sigla   String?  @db.VarChar(32)
  identificador_cor     String?  @db.VarChar(32)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  cliente     Cliente          @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  empresa     Empresa          @relation(fields: [cliente_id, empresa_id], references: [cliente_id, id], onDelete: Restrict)
  area        AreaPastagem     @relation(fields: [cliente_id, area_id], references: [cliente_id, id], onDelete: Restrict)
  loteEntrada Lote?            @relation(fields: [cliente_id, lote_entrada_id], references: [cliente_id, id], onDelete: Restrict)
  partidas    PartidaRebanho[]
  pesos       PesoRebanho[]
  tarefas     LancamentoTarefa[]

  @@unique([cliente_id, id])
  /// Alvo das FKs com empresa (partida/peso não cruzam empresa) — R2E-R1.
  @@unique([cliente_id, empresa_id, id])
  @@unique([cliente_id, empresa_id, area_id, chave_identidade])
  @@index([cliente_id, empresa_id, area_id])
  @@index([cliente_id, lote_entrada_id])
}

/// Fato do rebanho (imutável): tipo, dia operacional, quando foi gravado e
/// por quem. Cancelar marca `situacao = 'cancelado'` e desativa as partidas;
/// nada é apagado nem tem a data reescrita.
model EventoRebanho {
  id                        String    @id @default(cuid())
  cliente_id                String    @db.VarChar(64)
  empresa_id                String    @db.VarChar(64)
  tipo                      String    @db.VarChar(32)
  data_operacional          DateTime  @db.Date
  registrado_em             DateTime  @default(now())
  registrado_por_usuario_id String?   @db.VarChar(64)
  operation_id              String    @db.VarChar(160)
  situacao                  String    @default("ativo") @db.VarChar(16)
  cancelado_em              DateTime?
  cancelado_por_usuario_id  String?   @db.VarChar(64)
  motivo_cancelamento       String?   @db.VarChar(500)
  movimentacao_id           String?   @db.VarChar(64)
  dados                     Json      @default("{}")
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  cliente  Cliente          @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  empresa  Empresa          @relation(fields: [cliente_id, empresa_id], references: [cliente_id, id], onDelete: Restrict)
  partidas PartidaRebanho[]
  pesos    PesoRebanho[]

  @@unique([cliente_id, id])
  /// Alvo das FKs com empresa (partida/peso não cruzam empresa) — R2E-R1.
  @@unique([cliente_id, empresa_id, id])
  @@unique([cliente_id, empresa_id, tipo, operation_id])
  @@index([cliente_id, empresa_id, data_operacional])
  @@index([cliente_id, movimentacao_id])
}

/// Delta de cabeças numa posição, no dia operacional do evento. Saldo da
/// posição numa data = soma das partidas ATIVAS até o fim daquele dia.
model PartidaRebanho {
  id               String   @id @default(cuid())
  cliente_id       String   @db.VarChar(64)
  empresa_id       String   @db.VarChar(64)
  evento_id        String   @db.VarChar(64)
  posicao_id       String   @db.VarChar(64)
  data_operacional DateTime @db.Date
  delta            Int
  ativa            Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cliente Cliente        @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  evento  EventoRebanho  @relation(fields: [cliente_id, empresa_id, evento_id], references: [cliente_id, empresa_id, id], onDelete: Restrict)
  posicao PosicaoRebanho @relation(fields: [cliente_id, empresa_id, posicao_id], references: [cliente_id, empresa_id, id], onDelete: Restrict)

  @@unique([cliente_id, id])
  @@index([cliente_id, posicao_id, data_operacional])
  @@index([cliente_id, evento_id])
}

/// Peso médio observado numa posição numa data (R2E-R1): pesagem medida ou
/// peso resultante de transferência/junção/mudança/nascimento. Série histórica:
/// o peso de uma posição numa data é a última observação ATIVA até aquele dia;
/// `PosicaoRebanho.peso_medio_kg` é a projeção da última. `peso_medio_kg` NULL =
/// desconhecido (nunca zero). Cancelar o evento desativa a observação.
model PesoRebanho {
  id               String   @id @default(cuid())
  cliente_id       String   @db.VarChar(64)
  empresa_id       String   @db.VarChar(64)
  evento_id        String   @db.VarChar(64)
  posicao_id       String   @db.VarChar(64)
  data_operacional DateTime @db.Date
  peso_medio_kg    Decimal? @db.Decimal(14, 4)
  medido           Boolean  @default(false)
  ativa            Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cliente Cliente        @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  evento  EventoRebanho  @relation(fields: [cliente_id, empresa_id, evento_id], references: [cliente_id, empresa_id, id], onDelete: Restrict)
  posicao PosicaoRebanho @relation(fields: [cliente_id, empresa_id, posicao_id], references: [cliente_id, empresa_id, id], onDelete: Restrict)

  @@unique([cliente_id, id])
  @@index([cliente_id, posicao_id, data_operacional])
  @@index([cliente_id, evento_id])
}

/// D-PROD-146 — Gestão P1: centro de custo (onde o custo nasce: Curral, Oficina...).
/// Árvore opcional pela FK composta (cliente_id, empresa_id, pai_id): o pai é do
/// MESMO tenant e da MESMA empresa por construção do banco. Sem valores
/// financeiros e sem exclusão física (inativação).
model CentroCusto {
  id          String   @id @default(cuid())
  cliente_id  String   @db.VarChar(64)
  empresa_id  String   @db.VarChar(64)
  numero      String   @db.VarChar(32)
  nome        String   @db.VarChar(120)
  descricao   String?  @db.VarChar(500)
  pai_id      String?  @db.VarChar(64)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cliente  Cliente                @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  empresa  Empresa                @relation(fields: [cliente_id, empresa_id], references: [cliente_id, id], onDelete: Restrict)
  pai      CentroCusto?           @relation("CentroCustoArvore", fields: [cliente_id, empresa_id, pai_id], references: [cliente_id, empresa_id, id], onDelete: Restrict)
  filhos   CentroCusto[]          @relation("CentroCustoArvore")
  vinculos CentroCustoResultado[]
  rateiosFinanceiros OperacaoFinanceiraRateio[]
  rateiosItensFinanceiros OperacaoFinanceiraItemRateio[]
  // D-PROD-157 — centro de custo do bem (mesma empresa pela FK composta).
  bensPatrimoniais BemPatrimonial[]
  // D-PROD-190 — snapshot do centro de custo no apontamento de atividade.
  atividades Atividade[]
  // D-PROD-197 — centro de custo padrão dos tipos de atividade.
  tiposAtividadePadrao  TipoAtividade[]

  @@unique([cliente_id, id])
  /// Alvo das FKs com empresa (pai e vínculo não cruzam empresa).
  @@unique([cliente_id, empresa_id, id])
  @@unique([cliente_id, numero])
  @@unique([cliente_id, empresa_id, nome])
  @@index([cliente_id, empresa_id, ativo])
  @@index([cliente_id, empresa_id, pai_id])
  @@index([cliente_id, empresa_id, createdAt, id])
}

/// D-PROD-146 — Gestão P1: centro de resultado (atividade a apurar: Cria, Recria,
/// Soja...). Não é Natureza Financeira. Mesma forma de árvore do centro de custo.
model CentroResultado {
  id          String   @id @default(cuid())
  cliente_id  String   @db.VarChar(64)
  empresa_id  String   @db.VarChar(64)
  numero      String   @db.VarChar(32)
  nome        String   @db.VarChar(120)
  descricao   String?  @db.VarChar(500)
  pai_id      String?  @db.VarChar(64)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cliente  Cliente                @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  empresa  Empresa                @relation(fields: [cliente_id, empresa_id], references: [cliente_id, id], onDelete: Restrict)
  pai      CentroResultado?       @relation("CentroResultadoArvore", fields: [cliente_id, empresa_id, pai_id], references: [cliente_id, empresa_id, id], onDelete: Restrict)
  filhos   CentroResultado[]      @relation("CentroResultadoArvore")
  vinculos CentroCustoResultado[]
  rateiosFinanceiros OperacaoFinanceiraRateio[]
  rateiosItensFinanceiros OperacaoFinanceiraItemRateio[]
  // D-PROD-190 — centro de resultado informado no apontamento de atividade.
  atividades Atividade[]
  // D-PROD-197 — centro de resultado padrão dos tipos de atividade.
  tiposAtividadePadrao  TipoAtividade[]

  @@unique([cliente_id, id])
  @@unique([cliente_id, empresa_id, id])
  @@unique([cliente_id, numero])
  @@unique([cliente_id, empresa_id, nome])
  @@index([cliente_id, empresa_id, ativo])
  @@index([cliente_id, empresa_id, pai_id])
  @@index([cliente_id, empresa_id, createdAt, id])
}

/// D-PROD-146 — combinação POSSÍVEL centro de custo × centro de resultado (N:N),
/// opcional. Catálogo de combinações: não gera lançamento nem atribui custo.
/// As FKs compostas garantem no banco que os dois centros são do mesmo tenant
/// E da mesma empresa do vínculo.
model CentroCustoResultado {
  id                  String   @id @default(cuid())
  cliente_id          String   @db.VarChar(64)
  empresa_id          String   @db.VarChar(64)
  centro_custo_id     String   @db.VarChar(64)
  centro_resultado_id String   @db.VarChar(64)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  cliente         Cliente         @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  empresa         Empresa         @relation(fields: [cliente_id, empresa_id], references: [cliente_id, id], onDelete: Restrict)
  centroCusto     CentroCusto     @relation(fields: [cliente_id, empresa_id, centro_custo_id], references: [cliente_id, empresa_id, id], onDelete: Restrict)
  centroResultado CentroResultado @relation(fields: [cliente_id, empresa_id, centro_resultado_id], references: [cliente_id, empresa_id, id], onDelete: Restrict)

  @@unique([cliente_id, id])
  @@unique([cliente_id, empresa_id, centro_custo_id, centro_resultado_id])
  @@index([cliente_id, empresa_id, centro_resultado_id])
}

/// D-PROD-153 — Gestão P2: natureza financeira GERENCIAL (catálogo que classifica
/// futuras receitas e despesas: "qual o tipo econômico?"). Não é plano de contas
/// contábil, não guarda valor, saldo nem lançamento. Árvore opcional do MESMO
/// tipo (RECEITA ou DESPESA), mesmo tenant e mesma empresa, garantida pela FK
/// composta (cliente_id, empresa_id, tipo, pai_id) → (cliente_id, empresa_id, tipo, id).
model NaturezaFinanceira {
  id          String   @id @default(cuid())
  cliente_id  String   @db.VarChar(64)
  empresa_id  String   @db.VarChar(64)
  numero      String   @db.VarChar(32)
  /// RECEITA | DESPESA (CHECK no banco); imutável depois de criado.
  tipo        String   @db.VarChar(10)
  nome        String   @db.VarChar(120)
  descricao   String?  @db.VarChar(500)
  pai_id      String?  @db.VarChar(64)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cliente Cliente              @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  empresa Empresa              @relation(fields: [cliente_id, empresa_id], references: [cliente_id, id], onDelete: Restrict)
  pai     NaturezaFinanceira?  @relation("NaturezaFinanceiraArvore", fields: [cliente_id, empresa_id, tipo, pai_id], references: [cliente_id, empresa_id, tipo, id], onDelete: Restrict, onUpdate: Restrict)
  filhos  NaturezaFinanceira[] @relation("NaturezaFinanceiraArvore")
  rateiosFinanceiros OperacaoFinanceiraRateio[]
  rateiosItensFinanceiros OperacaoFinanceiraItemRateio[]

  @@unique([cliente_id, id])
  /// Alvo de FKs futuras com empresa (operações que classificarem por natureza).
  @@unique([cliente_id, empresa_id, id])
  /// Alvo da FK do pai: o pai é do mesmo tenant, empresa E tipo.
  @@unique([cliente_id, empresa_id, tipo, id])
  @@unique([cliente_id, numero])
  /// Nome único por empresa e tipo ("Venda de animais" pode existir em RECEITA e não em DESPESA).
  @@unique([cliente_id, empresa_id, tipo, nome])
  @@index([cliente_id, empresa_id, tipo, ativo])
  @@index([cliente_id, empresa_id, pai_id])
  @@index([cliente_id, empresa_id, tipo, createdAt, id])
}


// ---------------------------------------------------------------------------
// D-PROD-155 — Gestão P3-01: Central Única de Lançamentos GERENCIAIS.
// Um documento (`OperacaoFinanceira`) PAGAR|RECEBER × COM_PRODUTOS|SEM_PRODUTOS
// × AVISTA|PRAZO|PARCELADO, com itens, rateio GLOBAL por natureza/centros,
// títulos (uma linha por parcela) e liquidações MANUAIS (sem conciliação, OFX,
// DRE, plano de contas, fiscal, câmbio ou contabilidade). Dinheiro em
// Decimal(18,4), quantidade em Decimal(14,4) (KG, como o estoque), preço em
// Decimal(18,6) e percentual em Decimal(9,6). Domínios fechados por CHECK SQL
// (sem enum Prisma). Toda FK para tabela tenant inclui `cliente_id`.
// ---------------------------------------------------------------------------

/// Perfil financeiro da empresa (onboarding obrigatório): moeda/país/locale do
/// catálogo FECHADO (`financeiroCatalogo.js`). País é metadado, sem efeito fiscal.
model PerfilFinanceiroEmpresa {
  id              String   @id @default(cuid())
  cliente_id      String   @db.VarChar(64)
  empresa_id      String   @db.VarChar(64)
  pais            String   @db.VarChar(2)
  moeda           String   @db.VarChar(3)
  locale          String   @db.VarChar(35)
  versao_contrato Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  empresa Empresa @relation(fields: [cliente_id, empresa_id], references: [cliente_id, id], onDelete: Restrict)

  @@unique([cliente_id, id])
  @@unique([cliente_id, empresa_id])
}

/// Cabeçalho do documento. `documento_chave_ativa` = `documento_referencia` só
/// enquanto CONFIRMADO (NULL em rascunho/cancelado): a unique abaixo barra a
/// duplicidade documental entre documentos confirmados (NULLs são distintos).
model OperacaoFinanceira {
  id                        String    @id @default(cuid())
  cliente_id                String    @db.VarChar(64)
  empresa_id                String    @db.VarChar(64)
  numero                    String    @db.VarChar(32)
  status                    String    @db.VarChar(16)
  direcao                   String    @db.VarChar(8)
  conteudo                  String    @db.VarChar(16)
  condicao                  String    @db.VarChar(12)
  parceiro_id               String    @db.VarChar(64)
  parceiro_nome             String    @db.VarChar(255)
  descricao                 String?   @db.VarChar(500)
  documento_referencia      String?   @db.VarChar(64)
  documento_chave_ativa     String?   @db.VarChar(64)
  data_emissao              DateTime  @db.Date
  data_operacional          DateTime? @db.Date
  moeda                     String    @db.VarChar(3)
  moeda_casas               Int
  valor_bruto               Decimal   @db.Decimal(18, 4)
  valor_desconto            Decimal   @default(0) @db.Decimal(18, 4)
  valor_acrescimo           Decimal   @default(0) @db.Decimal(18, 4)
  valor_total               Decimal   @db.Decimal(18, 4)
  rateio_modo               String    @db.VarChar(12)
  /// D-PROD-156 (P3-02): GERAL | POR_ITEM, gravado explícito em POST/PUT.
  /// NULL = documento anterior à P3-02, lido como GERAL. O domínio é conferido
  /// no serviço (a migration expand-only não põe CHECK em tabela antiga).
  rateio_escopo             String?   @db.VarChar(12)
  metodo_preferido          String?   @db.VarChar(16)
  versao                    Int       @default(1)
  versao_contrato           Int       @default(1)
  criado_por_usuario_id     String?   @db.VarChar(64)
  confirmado_por_usuario_id String?   @db.VarChar(64)
  confirmado_em             DateTime?
  cancelado_por_usuario_id  String?   @db.VarChar(64)
  cancelado_em              DateTime?
  motivo_cancelamento       String?   @db.VarChar(500)
  /// D-PROD-158 (P3-03): exclusão LÓGICA de documento confirmado (estornado como
  /// o cancelamento, status CANCELADO). Fora da lista operacional padrão. Anulável,
  /// sem CHECK (a migration expand-only não põe CHECK em tabela antiga).
  excluido_em               DateTime?
  /// D-PROD-158 (P3-03): versão substituída por retificação (SUBSTITUICAO): o
  /// documento foi estornado e cancelado e um documento novo assumiu o número.
  /// Fora da lista operacional padrão.
  retificado_em             DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  cliente       Cliente                    @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  empresa       Empresa                    @relation(fields: [cliente_id, empresa_id], references: [cliente_id, id], onDelete: Restrict)
  parceiro      Fornecedor                 @relation(fields: [cliente_id, parceiro_id], references: [cliente_id, id], onDelete: Restrict)
  criadoPor     Usuario?                   @relation("OperacaoFinanceiraCriadoPor", fields: [cliente_id, criado_por_usuario_id], references: [cliente_id, id], onDelete: Restrict)
  confirmadoPor Usuario?                   @relation("OperacaoFinanceiraConfirmadoPor", fields: [cliente_id, confirmado_por_usuario_id], references: [cliente_id, id], onDelete: Restrict)
  canceladoPor  Usuario?                   @relation("OperacaoFinanceiraCanceladoPor", fields: [cliente_id, cancelado_por_usuario_id], references: [cliente_id, id], onDelete: Restrict)
  itens         OperacaoFinanceiraItem[]
  rateios       OperacaoFinanceiraRateio[]
  itemRateios   OperacaoFinanceiraItemRateio[]
  titulos       TituloFinanceiro[]
  // D-PROD-158: eventos de retificação/exclusão SOBRE este documento e o evento
  // de substituição de que ele NASCEU (no máximo um).
  eventos       OperacaoFinanceiraEvento[] @relation("OperacaoFinanceiraEventoOperacao")
  eventosOrigem OperacaoFinanceiraEvento[] @relation("OperacaoFinanceiraEventoNova")

  @@unique([cliente_id, id])
  @@unique([cliente_id, empresa_id, id])
  /// Alvo da FK do rateio: a direção do rateio é a do documento.
  @@unique([cliente_id, empresa_id, id, direcao])
  @@unique([cliente_id, numero])
  @@unique([cliente_id, empresa_id, direcao, parceiro_id, documento_chave_ativa])
  @@index([cliente_id, empresa_id, createdAt, id])
  @@index([cliente_id, empresa_id, status, createdAt, id])
  @@index([cliente_id, parceiro_id])
}

/// Item do documento COM_PRODUTOS. MERCADORIA mexe no estoque (KG) pelo motor
/// físico na confirmação; SERVICO não mexe em estoque. D-PROD-162: item de
/// Produto em litros usa `unidade = 'L'`, `fator_kg = 1` e `quantidade_estoque`
/// em L (as colunas mantêm o nome; CHECKs alargados na migration da D-PROD-162).
model OperacaoFinanceiraItem {
  id                      String   @id @default(cuid())
  cliente_id              String   @db.VarChar(64)
  empresa_id              String   @db.VarChar(64)
  operacao_id             String   @db.VarChar(64)
  ordem                   Int
  tipo_item               String   @db.VarChar(12)
  produto_id              String?  @db.VarChar(64)
  produto_nome            String?  @db.VarChar(255)
  descricao               String?  @db.VarChar(255)
  local_estoque_id        String?  @db.VarChar(64)
  local_estoque_nome      String?  @db.VarChar(255)
  unidade                 String   @db.VarChar(8)
  quantidade              Decimal  @db.Decimal(14, 4)
  fator_kg                Decimal? @db.Decimal(14, 4)
  quantidade_estoque      Decimal? @db.Decimal(14, 4)
  valor_unitario          Decimal  @db.Decimal(18, 6)
  valor_total             Decimal  @db.Decimal(18, 4)
  /// Custo de aquisição líquido (rodada 4): desconto e acréscimo do cabeçalho
  /// rateados por linha (maiores restos na moeda); líquido = subtotal −
  /// desconto + acréscimo (CHECKs na migration). Na compra de mercadoria é o
  /// valor do movimento de entrada e a base do custo do lote.
  valor_desconto_rateado  Decimal  @default(0) @db.Decimal(18, 4)
  valor_acrescimo_rateado Decimal  @default(0) @db.Decimal(18, 4)
  valor_liquido           Decimal  @db.Decimal(18, 4)
  movimentacao_estoque_id String?  @db.VarChar(64)
  estoque_lote_nota_id    String?  @db.VarChar(64)
  movimentacao_estorno_id String?  @db.VarChar(64)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  cliente             Cliente                         @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  operacao            OperacaoFinanceira              @relation(fields: [cliente_id, empresa_id, operacao_id], references: [cliente_id, empresa_id, id], onDelete: Restrict)
  produto             Produto?                        @relation(fields: [cliente_id, produto_id], references: [cliente_id, id], onDelete: Restrict)
  localEstoque        LocalEstoque?                   @relation(fields: [cliente_id, local_estoque_id], references: [cliente_id, id], onDelete: Restrict)
  movimentacao        MovimentacaoEstoque?            @relation("OperacaoFinanceiraItemMovimento", fields: [cliente_id, movimentacao_estoque_id], references: [cliente_id, id], onDelete: Restrict)
  movimentacaoEstorno MovimentacaoEstoque?            @relation("OperacaoFinanceiraItemEstorno", fields: [cliente_id, movimentacao_estorno_id], references: [cliente_id, id], onDelete: Restrict)
  loteEntrada         EstoqueLoteNota?                @relation("OperacaoFinanceiraItemLoteEntrada", fields: [cliente_id, estoque_lote_nota_id], references: [cliente_id, id], onDelete: Restrict)
  consumos            OperacaoFinanceiraConsumoLote[]
  rateios             OperacaoFinanceiraItemRateio[]

  @@unique([cliente_id, id])
  @@unique([cliente_id, empresa_id, id])
  @@unique([cliente_id, operacao_id, ordem])
  @@unique([cliente_id, movimentacao_estoque_id])
  @@unique([cliente_id, movimentacao_estorno_id])
  @@unique([cliente_id, estoque_lote_nota_id])
  @@index([cliente_id, empresa_id, operacao_id])
  @@index([cliente_id, produto_id])
  /// Bloqueio de exclusão de local (D-PROD-155 §8.5) e checagem da FK.
  @@index([cliente_id, local_estoque_id])
}

/// Fatia FIFO consumida por um item de SAÍDA (venda): de qual lote, quanto e a
/// que custo. O cancelamento devolve cada fatia ao SEU lote.
model OperacaoFinanceiraConsumoLote {
  id                   String   @id @default(cuid())
  cliente_id           String   @db.VarChar(64)
  empresa_id           String   @db.VarChar(64)
  item_id              String   @db.VarChar(64)
  estoque_lote_nota_id String   @db.VarChar(64)
  quantidade           Decimal  @db.Decimal(14, 4)
  custo_unitario       Decimal  @db.Decimal(14, 4)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  cliente Cliente                @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  item    OperacaoFinanceiraItem @relation(fields: [cliente_id, empresa_id, item_id], references: [cliente_id, empresa_id, id], onDelete: Restrict)
  lote    EstoqueLoteNota        @relation("OperacaoFinanceiraConsumoDoLote", fields: [cliente_id, estoque_lote_nota_id], references: [cliente_id, id], onDelete: Restrict)

  @@unique([cliente_id, id])
  @@unique([cliente_id, item_id, estoque_lote_nota_id])
  /// Bloqueio de PATCH/DELETE administrativo do lote (§8.5) e checagem da FK.
  @@index([cliente_id, estoque_lote_nota_id])
}

/// Rateio GLOBAL do documento. A FK com a direção amarra PAGAR→DESPESA e
/// RECEBER→RECEITA (CHECK) com a natureza do MESMO tipo (FK com tipo).
model OperacaoFinanceiraRateio {
  id                    String   @id @default(cuid())
  cliente_id            String   @db.VarChar(64)
  empresa_id            String   @db.VarChar(64)
  operacao_id           String   @db.VarChar(64)
  operacao_direcao      String   @db.VarChar(8)
  ordem                 Int
  natureza_id           String   @db.VarChar(64)
  natureza_tipo         String   @db.VarChar(10)
  natureza_nome         String   @db.VarChar(120)
  centro_custo_id       String?  @db.VarChar(64)
  centro_custo_nome     String?  @db.VarChar(120)
  centro_resultado_id   String?  @db.VarChar(64)
  centro_resultado_nome String?  @db.VarChar(120)
  percentual            Decimal? @db.Decimal(9, 6)
  valor                 Decimal  @db.Decimal(18, 4)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  cliente         Cliente            @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  operacao        OperacaoFinanceira @relation(fields: [cliente_id, empresa_id, operacao_id, operacao_direcao], references: [cliente_id, empresa_id, id, direcao], onDelete: Restrict, onUpdate: Restrict)
  natureza        NaturezaFinanceira @relation(fields: [cliente_id, empresa_id, natureza_tipo, natureza_id], references: [cliente_id, empresa_id, tipo, id], onDelete: Restrict, onUpdate: Restrict)
  centroCusto     CentroCusto?       @relation(fields: [cliente_id, empresa_id, centro_custo_id], references: [cliente_id, empresa_id, id], onDelete: Restrict)
  centroResultado CentroResultado?   @relation(fields: [cliente_id, empresa_id, centro_resultado_id], references: [cliente_id, empresa_id, id], onDelete: Restrict)

  @@unique([cliente_id, id])
  @@unique([cliente_id, operacao_id, ordem])
  @@index([cliente_id, empresa_id, natureza_id])
}

/// D-PROD-156 (P3-02) — rateio gerencial POR ITEM: as linhas de natureza e
/// centros de UM item (MERCADORIA ou SERVICO). Base = `valor_liquido` do item
/// (subtotal − desconto rateado + acréscimo rateado); Σ das linhas do item =
/// líquido do item, e Σ de todos os itens = `valor_total` do documento. Só
/// existe com `OperacaoFinanceira.rateio_escopo = 'POR_ITEM'` (nunca junto com o
/// rateio geral). Classificação gerencial: não cria título, movimento nem custo.
/// As FKs compostas amarram o tenant, a empresa, a direção do documento
/// (PAGAR→DESPESA, RECEBER→RECEITA pelo CHECK) e o tipo da natureza.
model OperacaoFinanceiraItemRateio {
  id                    String   @id @default(cuid())
  cliente_id            String   @db.VarChar(64)
  empresa_id            String   @db.VarChar(64)
  operacao_id           String   @db.VarChar(64)
  operacao_direcao      String   @db.VarChar(8)
  item_id               String   @db.VarChar(64)
  /// Ordem da linha DENTRO do item (1..n).
  ordem                 Int
  natureza_id           String   @db.VarChar(64)
  natureza_tipo         String   @db.VarChar(10)
  natureza_nome         String   @db.VarChar(120)
  centro_custo_id       String?  @db.VarChar(64)
  centro_custo_nome     String?  @db.VarChar(120)
  centro_resultado_id   String?  @db.VarChar(64)
  centro_resultado_nome String?  @db.VarChar(120)
  percentual            Decimal? @db.Decimal(9, 6)
  valor                 Decimal  @db.Decimal(18, 4)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  cliente         Cliente                @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  operacao        OperacaoFinanceira     @relation(fields: [cliente_id, empresa_id, operacao_id, operacao_direcao], references: [cliente_id, empresa_id, id, direcao], onDelete: Restrict, onUpdate: Restrict, map: "OperacaoFinanceiraItemRateio_operacao_fkey")
  item            OperacaoFinanceiraItem @relation(fields: [cliente_id, empresa_id, item_id], references: [cliente_id, empresa_id, id], onDelete: Restrict, map: "OperacaoFinanceiraItemRateio_item_fkey")
  natureza        NaturezaFinanceira     @relation(fields: [cliente_id, empresa_id, natureza_tipo, natureza_id], references: [cliente_id, empresa_id, tipo, id], onDelete: Restrict, onUpdate: Restrict, map: "OperacaoFinanceiraItemRateio_natureza_fkey")
  centroCusto     CentroCusto?           @relation(fields: [cliente_id, empresa_id, centro_custo_id], references: [cliente_id, empresa_id, id], onDelete: Restrict, map: "OperacaoFinanceiraItemRateio_centro_custo_fkey")
  centroResultado CentroResultado?       @relation(fields: [cliente_id, empresa_id, centro_resultado_id], references: [cliente_id, empresa_id, id], onDelete: Restrict, map: "OperacaoFinanceiraItemRateio_centro_resultado_fkey")

  @@unique([cliente_id, id])
  @@unique([cliente_id, item_id, ordem])
  @@index([cliente_id, empresa_id, operacao_id], map: "OperacaoFinanceiraItemRateio_operacao_idx")
  @@index([cliente_id, empresa_id, item_id], map: "OperacaoFinanceiraItemRateio_item_idx")
  @@index([cliente_id, empresa_id, natureza_id], map: "OperacaoFinanceiraItemRateio_natureza_idx")
}

/// Uma linha = uma parcela. PREVISTO = parcela de rascunho (não é obrigação);
/// confirmar promove a ABERTO; cancelar o documento leva a CANCELADO. QUITADO é
/// liquidação MANUAL registrada, não confirmação bancária.
model TituloFinanceiro {
  id              String   @id @default(cuid())
  cliente_id      String   @db.VarChar(64)
  empresa_id      String   @db.VarChar(64)
  operacao_id     String   @db.VarChar(64)
  direcao         String   @db.VarChar(8)
  parceiro_id     String   @db.VarChar(64)
  numero_parcela  Int
  total_parcelas  Int
  vencimento      DateTime @db.Date
  moeda           String   @db.VarChar(3)
  valor           Decimal  @db.Decimal(18, 4)
  valor_liquidado Decimal  @default(0) @db.Decimal(18, 4)
  status          String   @db.VarChar(12)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cliente     Cliente                       @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  operacao    OperacaoFinanceira            @relation(fields: [cliente_id, empresa_id, operacao_id], references: [cliente_id, empresa_id, id], onDelete: Restrict)
  parceiro    Fornecedor                    @relation(fields: [cliente_id, parceiro_id], references: [cliente_id, id], onDelete: Restrict)
  liquidacoes LiquidacaoFinanceira[]
  estornos    LiquidacaoFinanceiraEstorno[]

  @@unique([cliente_id, id])
  @@unique([cliente_id, empresa_id, id])
  @@unique([cliente_id, operacao_id, numero_parcela])
  @@index([cliente_id, empresa_id, status, vencimento, id])
  @@index([cliente_id, empresa_id, operacao_id])
  /// Bloqueio de exclusão de parceiro (§8.5) e checagem da FK.
  @@index([cliente_id, parceiro_id])
}

/// Liquidação manual registrada (fato imutável: só INSERT). O estorno é outra
/// tabela (sem autorreferência); o saldo do título é Σ liquidações sem estorno.
model LiquidacaoFinanceira {
  id                        String   @id @default(cuid())
  cliente_id                String   @db.VarChar(64)
  empresa_id                String   @db.VarChar(64)
  titulo_id                 String   @db.VarChar(64)
  valor                     Decimal  @db.Decimal(18, 4)
  data                      DateTime @db.Date
  metodo                    String   @db.VarChar(16)
  referencia                String?  @db.VarChar(120)
  observacao                String?  @db.VarChar(500)
  registrado_por_usuario_id String?  @db.VarChar(64)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  cliente       Cliente                       @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  titulo        TituloFinanceiro              @relation(fields: [cliente_id, empresa_id, titulo_id], references: [cliente_id, empresa_id, id], onDelete: Restrict)
  registradoPor Usuario?                      @relation("LiquidacaoFinanceiraRegistradoPor", fields: [cliente_id, registrado_por_usuario_id], references: [cliente_id, id], onDelete: Restrict)
  estornos      LiquidacaoFinanceiraEstorno[]

  @@unique([cliente_id, id])
  @@unique([cliente_id, empresa_id, id])
  /// Alvo da FK do estorno: o estorno é do MESMO título da liquidação.
  @@unique([cliente_id, empresa_id, titulo_id, id])
}

/// Estorno de UMA liquidação (no máximo um por liquidação). Sem coluna de valor:
/// o valor estornado é o da própria liquidação (sem duplicar o fato).
model LiquidacaoFinanceiraEstorno {
  id                        String   @id @default(cuid())
  cliente_id                String   @db.VarChar(64)
  empresa_id                String   @db.VarChar(64)
  titulo_id                 String   @db.VarChar(64)
  liquidacao_id             String   @db.VarChar(64)
  data                      DateTime @db.Date
  motivo                    String   @db.VarChar(500)
  registrado_por_usuario_id String?  @db.VarChar(64)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  cliente       Cliente              @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  // Nomes explícitos: os gerados (cortados em 63 bytes) colidiriam.
  titulo        TituloFinanceiro     @relation(fields: [cliente_id, empresa_id, titulo_id], references: [cliente_id, empresa_id, id], onDelete: Restrict, map: "LiquidacaoFinanceiraEstorno_titulo_fkey")
  liquidacao    LiquidacaoFinanceira @relation(fields: [cliente_id, empresa_id, titulo_id, liquidacao_id], references: [cliente_id, empresa_id, titulo_id, id], onDelete: Restrict, map: "LiquidacaoFinanceiraEstorno_liquidacao_fkey")
  registradoPor Usuario?             @relation("LiquidacaoFinanceiraEstornoRegistradoPor", fields: [cliente_id, registrado_por_usuario_id], references: [cliente_id, id], onDelete: Restrict)

  @@unique([cliente_id, id])
  @@unique([cliente_id, liquidacao_id])
  @@index([cliente_id, empresa_id, titulo_id])
}

/// D-PROD-158 (P3-03) — evento de RETIFICAÇÃO (NO_LUGAR ou SUBSTITUICAO) ou de
/// EXCLUSÃO lógica de um lançamento confirmado. `operacao_id` é o documento sobre
/// o qual o evento age; na SUBSTITUICAO, `operacao_nova_id` é o documento novo
/// (um documento nasce de no máximo uma substituição: unique abaixo; NULLs
/// repetidos são permitidos). `snapshot_anterior` guarda a versão anterior
/// (cabeçalho, itens com ids de movimento/lote/estorno, consumos, rateios geral e
/// por item, títulos) só como registro histórico: nenhuma regra o lê para decidir.
/// Domínios e forma por CHECK SQL (sem enum Prisma); FKs compostas por tenant.
model OperacaoFinanceiraEvento {
  id                String   @id @default(cuid())
  cliente_id        String   @db.VarChar(64)
  empresa_id        String   @db.VarChar(64)
  operacao_id       String   @db.VarChar(64)
  /// RETIFICACAO | EXCLUSAO.
  tipo              String   @db.VarChar(16)
  /// NO_LUGAR | SUBSTITUICAO (só na retificação).
  modo              String?  @db.VarChar(16)
  operacao_nova_id  String?  @db.VarChar(64)
  numero_original   String   @db.VarChar(32)
  versao_anterior   Int
  versao_nova       Int
  motivo            String   @db.VarChar(500)
  usuario_id        String?  @db.VarChar(64)
  snapshot_anterior Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cliente      Cliente             @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  operacao     OperacaoFinanceira  @relation("OperacaoFinanceiraEventoOperacao", fields: [cliente_id, empresa_id, operacao_id], references: [cliente_id, empresa_id, id], onDelete: Restrict, map: "OperacaoFinanceiraEvento_operacao_fkey")
  operacaoNova OperacaoFinanceira? @relation("OperacaoFinanceiraEventoNova", fields: [cliente_id, empresa_id, operacao_nova_id], references: [cliente_id, empresa_id, id], onDelete: Restrict, map: "OperacaoFinanceiraEvento_operacao_nova_fkey")
  usuario      Usuario?            @relation("OperacaoFinanceiraEventoUsuario", fields: [cliente_id, usuario_id], references: [cliente_id, id], onDelete: Restrict, map: "OperacaoFinanceiraEvento_usuario_fkey")

  @@unique([cliente_id, id])
  @@unique([cliente_id, operacao_nova_id])
  @@index([cliente_id, empresa_id, operacao_id, createdAt], map: "OperacaoFinanceiraEvento_operacao_idx")
  @@index([cliente_id, empresa_id, operacao_nova_id], map: "OperacaoFinanceiraEvento_operacao_nova_idx")
}

// ---------------------------------------------------------------------------
// D-PROD-157 — Patrimônio e Frota P1-01: cadastros nativos de inventário,
// simplificados pela D-PROD-162 (sem perfis de medição, medições de benfeitoria,
// catálogo de combustíveis e fator kg/L). Catálogos do TENANT (família e tipo;
// sem empresa, como UnidadeMedida/LocalEstoque) e o bem da EMPRESA (fazenda
// atual, FK composta). O bem é a raiz do agregado: medidor, tanques e os
// Produtos aceitos por tanque só mudam pelo POST/PATCH do bem, numa transação,
// com CAS por `versao`. A depreciação é só PRÉVIA simulada (nada é gravado).
// Domínios fechados por CHECK SQL (sem enum Prisma); toda FK para tabela
// tenant inclui `cliente_id`.
// ---------------------------------------------------------------------------

/// Família patrimonial ("Máquinas", "Benfeitorias"...). `natureza` define as
/// capacidades do bem (medidor, tanques); IMUTÁVEL depois de criada.
/// Domínios (CHECK): natureza BENFEITORIA|MAQUINA|VEICULO|IMPLEMENTO|EQUIPAMENTO|OUTRO;
/// codigo `^[A-Z0-9_]{2,32}$`; ordem 0..9999; vida útil 1..1200 meses.
model FamiliaPatrimonial {
  id                     String   @id @default(cuid())
  cliente_id             String   @db.VarChar(64)
  codigo                 String   @db.VarChar(32)
  nome                   String   @db.VarChar(120)
  natureza               String   @db.VarChar(16)
  descricao              String?  @db.VarChar(500)
  ordem                  Int?
  vida_util_meses_padrao Int?
  ativo                  Boolean  @default(true)
  versao                 Int      @default(1)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  cliente Cliente           @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  tipos   TipoPatrimonial[]
  bens    BemPatrimonial[]

  @@unique([cliente_id, id])
  @@unique([cliente_id, codigo])
  @@unique([cliente_id, nome])
  @@index([cliente_id, ativo])
  @@index([cliente_id, createdAt, id])
}

/// Tipo patrimonial ("Trator de pneus", "Curral"...) de UMA família
/// (`familia_id` IMUTÁVEL). Perfis de medição sugeridos só para família BENFEITORIA.
model TipoPatrimonial {
  id                       String   @id @default(cuid())
  cliente_id               String   @db.VarChar(64)
  familia_id               String   @db.VarChar(64)
  codigo                   String   @db.VarChar(32)
  nome                     String   @db.VarChar(120)
  descricao                String?  @db.VarChar(500)
  vida_util_meses_sugerida Int?
  ativo                    Boolean  @default(true)
  versao                   Int      @default(1)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  cliente Cliente                 @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  familia FamiliaPatrimonial      @relation(fields: [cliente_id, familia_id], references: [cliente_id, id], onDelete: Restrict)
  bens    BemPatrimonial[]

  @@unique([cliente_id, id])
  @@unique([cliente_id, codigo])
  @@unique([cliente_id, familia_id, nome])
  @@index([cliente_id, familia_id, ativo])
  @@index([cliente_id, createdAt, id])
}

/// Bem patrimonial da EMPRESA (fazenda atual). `numero` pela sequência do
/// tenant (IMUTÁVEL); `natureza` copiada da família na criação (IMUTÁVEL).
/// Domínios (CHECK): propriedade PROPRIO|TERCEIRO|ARRENDADO|CEDIDO; medidor
/// SEM_MEDIDOR|HORIMETRO(h)|ODOMETRO(km)|CICLOS(ciclos), obrigatório para
/// MAQUINA/VEICULO/EQUIPAMENTO e proibido para BENFEITORIA; origem da leitura
/// CADASTRO_INICIAL|AJUSTE_CADASTRO; depreciação LINEAR só para bem PROPRIO,
/// residual VALOR xor PERCENTUAL. A depreciação aqui são só PARÂMETROS: nenhum
/// valor contábil, cota ou lançamento é gravado.
model BemPatrimonial {
  id                       String    @id @default(cuid())
  cliente_id               String    @db.VarChar(64)
  empresa_id               String    @db.VarChar(64)
  numero                   String    @db.VarChar(32)
  codigo_frota             String?   @db.VarChar(16)
  nome                     String    @db.VarChar(120)
  natureza                 String    @db.VarChar(16)
  familia_id               String    @db.VarChar(64)
  tipo_id                  String    @db.VarChar(64)
  propriedade              String    @default("PROPRIO") @db.VarChar(16)
  proprietario_parceiro_id String?   @db.VarChar(64)
  responsavel_usuario_id   String?   @db.VarChar(64)
  centro_custo_id          String?   @db.VarChar(64)
  area_id                  String?   @db.VarChar(64)
  localizacao_descricao    String?   @db.VarChar(255)
  marca                    String?   @db.VarChar(80)
  modelo                   String?   @db.VarChar(80)
  ano_fabricacao           Int?
  ano_modelo               Int?
  numero_serie             String?   @db.VarChar(40)
  chassi                   String?   @db.VarChar(17)
  placa                    String?   @db.VarChar(8)
  placa_uf                 String?   @db.VarChar(2)
  renavam                  String?   @db.VarChar(11)
  potencia_cv              Decimal?  @db.Decimal(14, 4)
  material                 String?   @db.VarChar(80)
  ano_conclusao            Int?
  compatibilidade          String?   @db.VarChar(255)
  especificacoes           String?   @db.VarChar(1000)
  observacoes              String?   @db.VarChar(2000)
  medidor_tipo             String?   @db.VarChar(16)
  medidor_unidade          String?   @db.VarChar(8)
  medidor_leitura_inicial  Decimal?  @db.Decimal(14, 4)
  medidor_leitura_atual    Decimal?  @db.Decimal(14, 4)
  medidor_data_leitura     DateTime? @db.Date
  medidor_origem           String?   @db.VarChar(24)
  data_aquisicao           DateTime? @db.Date
  data_disponibilidade     DateTime? @db.Date
  valor_aquisicao          Decimal?  @db.Decimal(18, 4)
  custo_incorporacao       Decimal?  @db.Decimal(18, 4)
  fornecedor_parceiro_id   String?   @db.VarChar(64)
  documento_referencia     String?   @db.VarChar(80)
  garantia_ate             DateTime? @db.Date
  depreciavel              Boolean   @default(false)
  depreciacao_metodo       String?   @db.VarChar(16)
  vida_util_meses          Int?
  residual_modo            String?   @db.VarChar(16)
  valor_residual           Decimal?  @db.Decimal(18, 4)
  residual_percentual      Decimal?  @db.Decimal(9, 6)
  data_inicio_depreciacao  DateTime? @db.Date
  ativo                    Boolean   @default(true)
  versao                   Int       @default(1)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  cliente      Cliente            @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  empresa      Empresa            @relation(fields: [cliente_id, empresa_id], references: [cliente_id, id], onDelete: Restrict)
  familia      FamiliaPatrimonial @relation(fields: [cliente_id, familia_id], references: [cliente_id, id], onDelete: Restrict)
  tipo         TipoPatrimonial    @relation(fields: [cliente_id, tipo_id], references: [cliente_id, id], onDelete: Restrict)
  proprietario Fornecedor?        @relation("BemPatrimonialProprietario", fields: [cliente_id, proprietario_parceiro_id], references: [cliente_id, id], onDelete: Restrict)
  fornecedor   Fornecedor?        @relation("BemPatrimonialFornecedor", fields: [cliente_id, fornecedor_parceiro_id], references: [cliente_id, id], onDelete: Restrict)
  responsavel  Usuario?           @relation("BemPatrimonialResponsavel", fields: [cliente_id, responsavel_usuario_id], references: [cliente_id, id], onDelete: Restrict)
  centroCusto  CentroCusto?       @relation(fields: [cliente_id, empresa_id, centro_custo_id], references: [cliente_id, empresa_id, id], onDelete: Restrict)
  area         AreaPastagem?      @relation(fields: [cliente_id, area_id], references: [cliente_id, id], onDelete: Restrict)
  tanques      TanqueBem[]
  // D-PROD-159 — abastecimentos do bem (a leitura do medidor do abastecimento vive lá).
  abastecimentos AbastecimentoBem[]
  // D-PROD-200 — atividades (cabeçalho) que têm este bem como máquina.
  atividades     Atividade[]    @relation("AtividadeBem")

  @@unique([cliente_id, id])
  @@unique([cliente_id, empresa_id, id])
  @@unique([cliente_id, numero])
  /// Código de frota único por empresa quando presente (NULLs não colidem).
  @@unique([cliente_id, empresa_id, codigo_frota])
  @@index([cliente_id, empresa_id, createdAt, id])
  @@index([cliente_id, empresa_id, ativo])
  @@index([cliente_id, familia_id])
  @@index([cliente_id, tipo_id])
  /// Bloqueio de exclusão de parceiro (PARCEIRO_EM_USO) e checagem da FK.
  @@index([cliente_id, proprietario_parceiro_id])
  @@index([cliente_id, fornecedor_parceiro_id])
  @@index([cliente_id, responsavel_usuario_id])
  @@index([cliente_id, empresa_id, centro_custo_id])
  @@index([cliente_id, area_id])
}

/// Tanque de combustível do bem (MAQUINA/VEICULO/EQUIPAMENTO). Nunca removido,
/// só inativado; o identificador de tanque inativo continua reservado no bem.
/// Sem `versao` própria: o CAS é o do bem (raiz do agregado).
model TanqueBem {
  id                String   @id @default(cuid())
  cliente_id        String   @db.VarChar(64)
  bem_id            String   @db.VarChar(64)
  identificador     String   @db.VarChar(40)
  capacidade_litros Decimal  @db.Decimal(14, 4)
  observacao        String?  @db.VarChar(255)
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cliente      Cliente                @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  bem          BemPatrimonial         @relation(fields: [cliente_id, bem_id], references: [cliente_id, id], onDelete: Restrict)
  produtos     TanqueBemProduto[]
  // D-PROD-159 — abastecimentos neste tanque.
  abastecimentos AbastecimentoBem[]

  @@unique([cliente_id, id])
  @@unique([cliente_id, bem_id, id])
  @@unique([cliente_id, bem_id, identificador])
  @@index([cliente_id, createdAt, id])
}

/// D-PROD-162 — Produto do estoque ACEITO por um tanque do bem (substitui
/// TipoCombustivel, TanqueBemCombustivel, TipoCombustivelProduto e o fator).
/// Apagado só quando retirado sem nenhum abastecimento; com histórico, o sync
/// só desliga `ativo` (a FK do abastecimento segura o par). Coerência Produto.empresa_id =
/// bem.empresa_id é invariante do SERVIÇO (Produto, tabela antiga, não tem
/// unique por empresa).
model TanqueBemProduto {
  id         String   @id @default(cuid())
  cliente_id String   @db.VarChar(64)
  tanque_id  String   @db.VarChar(64)
  produto_id String   @db.VarChar(64)
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cliente        Cliente            @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  tanque         TanqueBem          @relation(fields: [cliente_id, tanque_id], references: [cliente_id, id], onDelete: Restrict)
  produto        Produto            @relation(fields: [cliente_id, produto_id], references: [cliente_id, id], onDelete: Restrict)
  abastecimentos AbastecimentoBem[]

  @@unique([cliente_id, id])
  @@unique([cliente_id, tanque_id, produto_id])
  @@index([cliente_id, produto_id])
  @@index([cliente_id, createdAt, id])
}

/// D-PROD-162 — abastecimento CONFIRMADO de um bem da EMPRESA: `quantidade`
/// na unidade do Produto (`unidade` = snapshot de unidade_principal_estoque,
/// L ou KG; CHECK), baixada EXATAMENTE pelo motor de estoque (FIFO), sem
/// conversão. Sem DELETE: CANCELADO com estorno exato.
model AbastecimentoBem {
  id                       String    @id @default(cuid())
  cliente_id               String    @db.VarChar(64)
  empresa_id               String    @db.VarChar(64)
  numero                   String    @db.VarChar(32)
  status                   String    @db.VarChar(16)
  bem_id                   String    @db.VarChar(64)
  tanque_id                String    @db.VarChar(64)
  produto_id               String    @db.VarChar(64)
  local_estoque_id         String    @db.VarChar(64)
  data_operacional         DateTime  @db.Date
  quantidade               Decimal   @db.Decimal(14, 4)
  unidade                  String    @db.VarChar(4)
  custo_total              Decimal   @db.Decimal(14, 4)
  custo_unitario           Decimal   @db.Decimal(14, 4)
  tanque_cheio             Boolean   @default(false)
  medidor_tipo             String    @db.VarChar(16)
  medidor_unidade          String?   @db.VarChar(8)
  medidor_leitura          Decimal?  @db.Decimal(14, 4)
  medidor_origem           String?   @db.VarChar(24)
  observacao               String?   @db.VarChar(500)
  referencia_externa       String?   @db.VarChar(64)
  operation_id             String    @db.VarChar(128)
  movimentacao_estoque_id  String    @db.VarChar(64)
  movimentacao_estorno_id  String?   @db.VarChar(64)
  criado_por_usuario_id    String?   @db.VarChar(64)
  cancelado_por_usuario_id String?   @db.VarChar(64)
  cancelado_em             DateTime?
  motivo_cancelamento      String?   @db.VarChar(500)
  versao                   Int       @default(1)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  cliente             Cliente                       @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  empresa             Empresa                       @relation(fields: [cliente_id, empresa_id], references: [cliente_id, id], onDelete: Restrict)
  bem                 BemPatrimonial                @relation(fields: [cliente_id, empresa_id, bem_id], references: [cliente_id, empresa_id, id], onDelete: Restrict)
  tanque              TanqueBem                     @relation(fields: [cliente_id, bem_id, tanque_id], references: [cliente_id, bem_id, id], onDelete: Restrict)
  produto             Produto                       @relation(fields: [cliente_id, produto_id], references: [cliente_id, id], onDelete: Restrict)
  aceite              TanqueBemProduto              @relation(fields: [cliente_id, tanque_id, produto_id], references: [cliente_id, tanque_id, produto_id], onDelete: Restrict)
  localEstoque        LocalEstoque                  @relation(fields: [cliente_id, local_estoque_id], references: [cliente_id, id], onDelete: Restrict)
  movimentacao        MovimentacaoEstoque           @relation("AbastecimentoBemMovimento", fields: [cliente_id, movimentacao_estoque_id], references: [cliente_id, id], onDelete: Restrict, map: "AbastecimentoBem_movimentacao_fkey")
  movimentacaoEstorno MovimentacaoEstoque?          @relation("AbastecimentoBemEstorno", fields: [cliente_id, movimentacao_estorno_id], references: [cliente_id, id], onDelete: Restrict, map: "AbastecimentoBem_estorno_fkey")
  criadoPor           Usuario?                      @relation("AbastecimentoBemCriadoPor", fields: [cliente_id, criado_por_usuario_id], references: [cliente_id, id], onDelete: Restrict, map: "AbastecimentoBem_criado_por_fkey")
  canceladoPor        Usuario?                      @relation("AbastecimentoBemCanceladoPor", fields: [cliente_id, cancelado_por_usuario_id], references: [cliente_id, id], onDelete: Restrict, map: "AbastecimentoBem_cancelado_por_fkey")
  consumos            AbastecimentoBemConsumoLote[]

  @@unique([cliente_id, id])
  @@unique([cliente_id, empresa_id, id])
  @@unique([cliente_id, numero])
  @@unique([cliente_id, operation_id])
  @@unique([cliente_id, movimentacao_estoque_id])
  @@unique([cliente_id, movimentacao_estorno_id])
  @@index([cliente_id, empresa_id, createdAt, id])
  @@index([cliente_id, empresa_id, bem_id, createdAt, id], map: "AbastecimentoBem_empresa_bem_keyset_idx")
  @@index([cliente_id, bem_id, status, data_operacional], map: "AbastecimentoBem_bem_status_data_idx")
  @@index([cliente_id, tanque_id, status, data_operacional], map: "AbastecimentoBem_tanque_status_data_idx")
  @@index([cliente_id, empresa_id, produto_id])
  @@index([cliente_id, produto_id])
  @@index([cliente_id, local_estoque_id])
}

/// D-PROD-159 (Patrimônio P1-02; D-PROD-162) — fatia FIFO consumida pelo
/// abastecimento: de qual lote, quanto (na unidade do abastecimento, L ou KG) e
/// a que custo, na ordem FIFO. O cancelamento devolve cada fatia ao SEU lote
/// (Σ quantidade = `quantidade` do abastecimento, na unidade dele, conferido no serviço).
model AbastecimentoBemConsumoLote {
  id                   String   @id @default(cuid())
  cliente_id           String   @db.VarChar(64)
  empresa_id           String   @db.VarChar(64)
  abastecimento_id     String   @db.VarChar(64)
  estoque_lote_nota_id String   @db.VarChar(64)
  ordem                Int
  quantidade           Decimal  @db.Decimal(14, 4)
  custo_unitario       Decimal  @db.Decimal(14, 4)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  cliente       Cliente          @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  abastecimento AbastecimentoBem @relation(fields: [cliente_id, empresa_id, abastecimento_id], references: [cliente_id, empresa_id, id], onDelete: Restrict, map: "AbastecimentoBemConsumoLote_abastecimento_fkey")
  lote          EstoqueLoteNota  @relation("AbastecimentoBemConsumoDoLote", fields: [cliente_id, estoque_lote_nota_id], references: [cliente_id, id], onDelete: Restrict, map: "AbastecimentoBemConsumoLote_lote_fkey")

  @@unique([cliente_id, id])
  @@unique([cliente_id, abastecimento_id, estoque_lote_nota_id], map: "AbastecimentoBemConsumoLote_abastecimento_lote_key")
  @@unique([cliente_id, abastecimento_id, ordem], map: "AbastecimentoBemConsumoLote_abastecimento_ordem_key")
  /// Bloqueio de PATCH/DELETE administrativo do lote (X1) e checagem da FK.
  @@index([cliente_id, estoque_lote_nota_id], map: "AbastecimentoBemConsumoLote_lote_idx")
}

// ---------------------------------------------------------------------------
// D-PROD-200 (Fatia 2 do Lançamento de Atividades) — dois níveis no lugar do
// apontamento de linha única (D-PROD-190/193, removido nesta fatia):
//
//   Atividade (CABEÇALHO, aberta: "Cigarrinha Pasto 01")
//     └─ AtividadeApontamento (um por dia/turno; `sequencia` 1, 2, … são as passadas)
//
// O que vem do cabeçalho é HERDADO e TRAVADO no apontamento: o apontamento não
// tem área, setor, safra, centro nem unidade. O cabeçalho tira do TIPO os
// snapshots de centro de custo, centro de resultado e unidade de produção
// (nunca relidos depois) e da ÁREA o setor. Sem DELETE físico: cancelar muda o
// status. As linhas de produto, máquina, mão de obra e serviço chegam nas
// Fatias 3 e 4, penduradas no apontamento.
//
// Escopo garantido pelo banco: toda FK é composta e tenant-aware, RESTRICT.
// Bem e centros apontam para (cliente_id, empresa_id, id): mesma empresa por
// construção; o apontamento aponta para a atividade por (cliente_id,
// empresa_id, id). Área, setor, tarefa e unidade só têm unique (cliente_id, id)
// nas tabelas antigas: a empresa da área, do setor e da tarefa é conferida no
// serviço (a unidade é do cliente).
// ---------------------------------------------------------------------------

/// D-PROD-200 — CABEÇALHO do Lançamento de Atividades. `numero`: sequência do tenant (entidade `Atividade`).
model Atividade {
  id                       String    @id @default(cuid())
  cliente_id               String    @db.VarChar(64)
  empresa_id               String    @db.VarChar(64)
  numero                   String    @db.VarChar(32)
  /// O nome que o operador reconhece: "Cigarrinha Pasto 01".
  nome                     String    @db.VarChar(120)
  tipo_atividade_id        String    @db.VarChar(64)
  /// SNAPSHOT do tipo na abertura.
  tipo_atividade_nome      String    @db.VarChar(255)
  grupo_atividade_id       String    @db.VarChar(64)
  /// SNAPSHOT do grupo do tipo na abertura.
  grupo_atividade_nome     String    @db.VarChar(255)
  area_id                  String?   @db.VarChar(64)
  /// HERDADO da área (nunca digitado); snapshot.
  setor_id                 String?   @db.VarChar(64)
  setor_nome               String?   @db.VarChar(255)
  /// Máquina da atividade: é o que a flag `exige_maquina` do tipo confere na abertura.
  bem_id                   String?   @db.VarChar(64)
  safra_ciclo              String?   @db.VarChar(32)
  /// SNAPSHOT do tipo (`centro_custo_padrao_id`), só se o centro for da mesma empresa e estiver ativo.
  centro_custo_id          String?   @db.VarChar(64)
  /// SNAPSHOT do tipo (`centro_resultado_padrao_id`), mesma regra.
  centro_resultado_id      String?   @db.VarChar(64)
  /// SNAPSHOT do tipo (`unidade_producao_id`, de UnidadeMedida).
  unidade_producao_id      String?   @db.VarChar(64)
  /// SNAPSHOT da sigla da unidade (também guarda a unidade de texto dos apontamentos convertidos).
  unidade_producao_sigla   String?   @db.VarChar(32)
  data_inicio              DateTime? @db.Date
  data_prevista_fim        DateTime? @db.Date
  data_conclusao           DateTime? @db.Date
  area_planejada           Decimal?  @db.Decimal(14, 4)
  /// Σ `area_executada_dia` dos apontamentos CONFIRMADO, recalculada a cada lançamento.
  area_executada           Decimal?  @db.Decimal(14, 4)
  /// Σ `quantidade_produzida_dia` dos apontamentos CONFIRMADO, recalculada a cada lançamento.
  quantidade_produzida     Decimal?  @db.Decimal(14, 4)
  /// A demanda de origem (a tarefa que pediu a atividade).
  lancamento_tarefa_id     String?   @db.VarChar(64)
  observacao               String?   @db.VarChar(2000)
  /// ABERTA | CONCLUIDA | CANCELADA (CHECK).
  status                   String    @default("ABERTA") @db.VarChar(16)
  concluida_em             DateTime?
  concluida_por_usuario_id String?   @db.VarChar(64)
  cancelada_em             DateTime?
  cancelado_por_usuario_id String?   @db.VarChar(64)
  motivo_cancelamento      String?   @db.VarChar(500)
  reaberta_em              DateTime?
  reaberta_por_usuario_id  String?   @db.VarChar(64)
  motivo_reabertura        String?   @db.VarChar(500)
  criado_por_usuario_id    String?   @db.VarChar(64)
  versao                   Int       @default(1)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  cliente          Cliente                @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  empresa          Empresa                @relation(fields: [cliente_id, empresa_id], references: [cliente_id, id], onDelete: Restrict)
  tipoAtividade    TipoAtividade          @relation(fields: [cliente_id, tipo_atividade_id], references: [cliente_id, id], onDelete: Restrict)
  grupoAtividade   GrupoAtividade         @relation(fields: [cliente_id, grupo_atividade_id], references: [cliente_id, id], onDelete: Restrict)
  area             AreaPastagem?          @relation(fields: [cliente_id, area_id], references: [cliente_id, id], onDelete: Restrict)
  setor            Setor?                 @relation(fields: [cliente_id, setor_id], references: [cliente_id, id], onDelete: Restrict)
  bem              BemPatrimonial?        @relation("AtividadeBem", fields: [cliente_id, empresa_id, bem_id], references: [cliente_id, empresa_id, id], onDelete: Restrict, map: "Atividade_bem_fkey")
  centroCusto      CentroCusto?           @relation(fields: [cliente_id, empresa_id, centro_custo_id], references: [cliente_id, empresa_id, id], onDelete: Restrict, map: "Atividade_centro_custo_fkey")
  centroResultado  CentroResultado?       @relation(fields: [cliente_id, empresa_id, centro_resultado_id], references: [cliente_id, empresa_id, id], onDelete: Restrict, map: "Atividade_centro_resultado_fkey")
  unidadeProducao  UnidadeMedida?         @relation(fields: [cliente_id, unidade_producao_id], references: [cliente_id, id], onDelete: Restrict)
  lancamentoTarefa LancamentoTarefa?      @relation(fields: [cliente_id, lancamento_tarefa_id], references: [cliente_id, id], onDelete: Restrict)
  criadoPor        Usuario?               @relation("AtividadeCriadaPor", fields: [cliente_id, criado_por_usuario_id], references: [cliente_id, id], onDelete: Restrict, map: "Atividade_criado_por_fkey")
  concluidaPor     Usuario?               @relation("AtividadeConcluidaPor", fields: [cliente_id, concluida_por_usuario_id], references: [cliente_id, id], onDelete: Restrict, map: "Atividade_concluida_por_fkey")
  canceladoPor     Usuario?               @relation("AtividadeCanceladaPor", fields: [cliente_id, cancelado_por_usuario_id], references: [cliente_id, id], onDelete: Restrict, map: "Atividade_cancelado_por_fkey")
  reabertaPor      Usuario?               @relation("AtividadeReabertaPor", fields: [cliente_id, reaberta_por_usuario_id], references: [cliente_id, id], onDelete: Restrict, map: "Atividade_reaberta_por_fkey")
  apontamentos     AtividadeApontamento[]

  @@unique([cliente_id, id])
  @@unique([cliente_id, empresa_id, id])
  @@unique([cliente_id, numero])
  @@index([cliente_id, empresa_id, createdAt, id])
  @@index([cliente_id, empresa_id, status, createdAt, id])
  @@index([cliente_id, empresa_id, tipo_atividade_id])
  @@index([cliente_id, area_id])
  @@index([cliente_id, setor_id])
  @@index([cliente_id, empresa_id, bem_id])
  @@index([cliente_id, lancamento_tarefa_id])
}

/// D-PROD-200 — APONTAMENTO de um dia/turno, filho da atividade (o antigo ApontamentoAtividade, virando filho).
/// `sequencia`: 1, 2, 3… por (atividade, dia, turno), calculada no servidor sob a trava da atividade — as passadas.
/// O unique trata `turno` nulo como valor (NULLS NOT DISTINCT, no migration.sql).
model AtividadeApontamento {
  id                       String    @id @default(cuid())
  cliente_id               String    @db.VarChar(64)
  empresa_id               String    @db.VarChar(64)
  atividade_id             String    @db.VarChar(64)
  data_operacional         DateTime  @db.Date
  /// MANHA | TARDE | NOITE | nulo (CHECK).
  turno                    String?   @db.VarChar(16)
  sequencia                Int
  operador_usuario_id      String?   @db.VarChar(64)
  area_executada_dia       Decimal?  @db.Decimal(14, 4)
  quantidade_produzida_dia Decimal?  @db.Decimal(14, 4)
  observacao               String?   @db.VarChar(2000)
  /// WEB | APP (CHECK).
  origem                   String    @default("WEB") @db.VarChar(16)
  /// CONFIRMADO | CANCELADO (CHECK).
  status                   String    @default("CONFIRMADO") @db.VarChar(16)
  cancelado_em             DateTime?
  cancelado_por_usuario_id String?   @db.VarChar(64)
  motivo_cancelamento      String?   @db.VarChar(500)
  criado_por_usuario_id    String?   @db.VarChar(64)
  versao                   Int       @default(1)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  cliente      Cliente   @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  empresa      Empresa   @relation(fields: [cliente_id, empresa_id], references: [cliente_id, id], onDelete: Restrict)
  atividade    Atividade @relation(fields: [cliente_id, empresa_id, atividade_id], references: [cliente_id, empresa_id, id], onDelete: Restrict, map: "AtividadeApontamento_atividade_fkey")
  operador     Usuario?  @relation("AtividadeApontamentoOperador", fields: [cliente_id, operador_usuario_id], references: [cliente_id, id], onDelete: Restrict, map: "AtividadeApontamento_operador_fkey")
  criadoPor    Usuario?  @relation("AtividadeApontamentoCriadoPor", fields: [cliente_id, criado_por_usuario_id], references: [cliente_id, id], onDelete: Restrict, map: "AtividadeApontamento_criado_por_fkey")
  canceladoPor Usuario?  @relation("AtividadeApontamentoCanceladoPor", fields: [cliente_id, cancelado_por_usuario_id], references: [cliente_id, id], onDelete: Restrict, map: "AtividadeApontamento_cancelado_por_fkey")

  @@unique([cliente_id, id])
  @@unique([cliente_id, empresa_id, id])
  @@unique([cliente_id, atividade_id, data_operacional, turno, sequencia], map: "AtividadeApontamento_atividade_dia_turno_sequencia_key")
  @@index([cliente_id, empresa_id, atividade_id])
  @@index([cliente_id, operador_usuario_id])
}

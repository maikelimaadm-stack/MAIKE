// ModeloBase1 Pecuário — fundação de tenant (P3) + capacidades migradas (P4+).
//
// Este schema implementa EXATAMENTE o contrato de
// `config/modelobase1-pecuario.json`.
//
// A P3 criou só a fundação — `Cliente`, `Usuario`, `AuditLog`,
// `EntidadeCodigoSequencia`, `RegistroAnexo` — e nenhum model de domínio, por
// não haver consumidor migrado. A partir da P4 cada capacidade entra **uma por
// missão**, quando existe consumidor real: a P4.1 traz `Setor` (D-PROD-25).
// `AreaPastagem` e o resto da geografia continuam na Base44 até a P4.2 — o
// schema não antecipa model sem consumidor.
//
// Invariantes travadas por `gate:tenancy` e `gate:indices`:
//
//   identidade   id String @id @default(cuid()); nunca vem do cliente HTTP
//   tenancy      cliente_id obrigatório em todo model tenant-scoped;
//                `Cliente` é a raiz e a única exceção (D-PROD-22)
//   unique       toda chave de negócio inclui cliente_id
//   índice       todo índice tenant-scoped começa por cliente_id
//   timestamps   createdAt e updatedAt em todo model persistente

// Sem `output` explícito: o Prisma resolve para o `node_modules` onde
// `@prisma/client` está instalado — a raiz do repositório. As dependências do
// backend vivem no `package.json` raiz, num lockfile só, para que
// `gate:package-sync` continue enxergando todas elas.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Cliente — raiz estrutural do tenant.
//
// Único model sem `cliente_id`, porque ele É o tenant: `Cliente.id` é a
// identidade da raiz de tenancy (D-PROD-22). Criar `cliente_id` autorreferente
// aqui é explicitamente proibido.
//
// `codigo` identifica o tenant internamente (bootstrap, suporte). Desde
// D-PROD-33 não entra na tela de login — o operador usa só usuário e senha.
// ---------------------------------------------------------------------------
model Cliente {
  id        String   @id @default(cuid())
  codigo    String   @unique @db.VarChar(64)
  nome      String   @db.VarChar(255)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios      Usuario[]
  auditLogs     AuditLog[]
  sequencias    EntidadeCodigoSequencia[]
  anexos        RegistroAnexo[]
  setores            Setor[]
  marcas             Marca[]
  unidadesMedida     UnidadeMedida[]
  gruposAtividade    GrupoAtividade[]
  tiposTarefa        TipoTarefa[]
  areasPastagem      AreaPastagem[]
  configuracoesIcone ConfiguracaoIcone[]
  pontosReferencia   PontoReferencia[]
  linhasGeograficas  LinhaGeografica[]
  lotes              Lote[]

  @@index([nome])
  @@index([ativo])
}

// ---------------------------------------------------------------------------
// Usuario — tenant-scoped.
//
// Mínimo necessário para autenticação própria. Sem Empresa, sem permissões,
// sem perfil empresarial, sem acesso_global: nada disso tem consumidor na P3.
//
// `senha_hash` é o único vestígio da senha. A senha pura nunca é persistida e
// nunca entra no AuditLog.
//
// `onDelete: Restrict` — apagar um Cliente que ainda tem usuários falha. A
// exclusão de Cliente é política explícita e revisada, nunca cascade acidental
// (contrato: `tenancy.clienteDeletePolicy = "explicit-reviewed"`).
// ---------------------------------------------------------------------------
model Usuario {
  id         String   @id @default(cuid())
  cliente_id String   @db.VarChar(64)
  nome       String   @db.VarChar(255)
  login      String   @db.VarChar(120)
  senha_hash String   @db.VarChar(255)
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cliente   Cliente    @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  auditLogs AuditLog[]

  @@unique([cliente_id, login])
  // Chave referenciável tenant-aware. Existe para que quem aponta para um
  // Usuario aponte para "este usuário DENTRO deste cliente", e não para um id
  // solto que poderia pertencer a outro tenant. Ver AuditLog.
  @@unique([cliente_id, id])
  @@index([cliente_id, ativo])
  // Login global entre contas ativas: migration `p6_1_login_global_hygiene` +
  // índice parcial SQL `Usuario_login_ativo_global_key` (D-PROD-35). No Prisma
  // permanece @@unique([cliente_id, login]); índice só em `login` violaria gate:indices.
}

// ---------------------------------------------------------------------------
// AuditLog — camada B da auditoria (a camada A são os timestamps por model).
//
// Diverge do PROJETOMG de propósito: lá `cliente_id` é nullable com
// `onDelete: SetNull`. Aqui ele é OBRIGATÓRIO — log de auditoria sem tenant não
// é auditável num sistema multi-tenant.
//
// `usuario_id` é opcional e ausente SOMENTE em evento de sistema. Por isso a
// relação com Usuario é `Restrict` e não `SetNull`: anular o ator faria um
// evento humano passar por evento de sistema, e o rastro mentiria.
//
// `dados_anteriores` e `dados_novos` nunca recebem senha, credencial, segredo
// ou conteúdo binário — a filtragem vive em `auditService`.
// ---------------------------------------------------------------------------
model AuditLog {
  id               String   @id @default(cuid())
  cliente_id       String   @db.VarChar(64)
  usuario_id       String?  @db.VarChar(64)
  acao             String   @db.VarChar(64)
  entidade         String   @db.VarChar(128)
  entidade_id      String?  @db.VarChar(128)
  dados_anteriores Json?
  dados_novos      Json?
  request_id       String   @db.VarChar(64)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Restrict)

  // FK COMPOSTA, tenant-aware. Aponta para [cliente_id, id] de Usuario, não
  // para o id solto.
  //
  // Com duas FKs independentes — cliente_id -> Cliente.id e usuario_id ->
  // Usuario.id — o banco aceitaria um AuditLog do Cliente A com ator do Cliente
  // B. O service nunca monta esse objeto, porque tenant e ator saem do mesmo
  // auth_context; mas o contrato declara `crossTenantRelationsAllowed = false`
  // e manda a constraint ser a última barreira. Regra que depende de o service
  // estar certo não é barreira, é convenção.
  //
  // `usuario_id` continua opcional para evento de sistema. O PostgreSQL usa
  // MATCH SIMPLE por padrão: com qualquer coluna da FK composta nula, a
  // verificação é dispensada — então `usuario_id = NULL` passa, que é
  // exatamente o comportamento desejado.
  usuario Usuario? @relation(fields: [cliente_id, usuario_id], references: [cliente_id, id], onDelete: Restrict)

  @@index([cliente_id, createdAt])
  @@index([cliente_id, entidade, entidade_id])
  @@index([cliente_id, usuario_id])
  @@index([cliente_id, request_id])
}

// ---------------------------------------------------------------------------
// EntidadeCodigoSequencia — numeração atômica.
//
// `escopo_id` é String NÃO NULA, por decisão da P3. No PostgreSQL, NULL nunca é
// igual a NULL num índice unique: com `escopo_id` nullable, duas linhas de
// sequência para a mesma entidade coexistiriam e distribuiriam números em
// paralelo — o unique não barraria nada, e o sintoma só apareceria sob
// concorrência.
//
// Sentinela: no escopo `tenant`, `escopo_id` recebe o próprio `cliente_id`.
// No escopo `empresa`, receberá o ID real da Empresa quando essa capacidade
// existir (P4–P6). A P3 suporta os dois tipos e NÃO decide qual entidade usa
// qual.
//
// A reserva é `UPDATE … RETURNING` dentro de transação. Nunca MAX+1, nunca
// COUNT(*)+1.
// ---------------------------------------------------------------------------
model EntidadeCodigoSequencia {
  id            String   @id @default(cuid())
  cliente_id    String   @db.VarChar(64)
  entidade      String   @db.VarChar(128)
  escopo_tipo   String   @db.VarChar(32)
  escopo_id     String   @db.VarChar(64)
  proximo_valor Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Restrict)

  @@unique([cliente_id, entidade, escopo_tipo, escopo_id])
  @@index([cliente_id, entidade])
}

// ---------------------------------------------------------------------------
// RegistroAnexo — registro genérico de anexo, independente de provider.
//
// `storage_key` é a IDENTIDADE persistente do objeto. URL pública é efêmera e
// nunca identidade — é por isso que não existe campo `file_url` aqui.
//
// Nenhum binário no PostgreSQL. `mime_type` e `tamanho_bytes` são validados no
// backend; `nome_original` é sanitizado antes de persistir.
//
// A P3 NÃO escolhe provedor de storage. `storage_key` é opaca de propósito.
// ---------------------------------------------------------------------------
model RegistroAnexo {
  id            String   @id @default(cuid())
  cliente_id    String   @db.VarChar(64)
  entidade      String   @db.VarChar(128)
  entidade_id   String   @db.VarChar(128)
  nome_original String   @db.VarChar(255)
  storage_key   String   @db.VarChar(1024)
  mime_type     String   @db.VarChar(255)
  tamanho_bytes Int
  checksum      String?  @db.VarChar(128)
  criado_por    String   @db.VarChar(64)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Restrict)

  @@unique([cliente_id, storage_key])
  @@index([cliente_id, entidade, entidade_id])
  @@index([cliente_id, createdAt])
}

// ---------------------------------------------------------------------------
// Setor — primeira capacidade de domínio migrada da Base44 (P4.1, D-PROD-25).
//
// `numero_setor` é identificador de NEGÓCIO, nunca linha: a chave primária
// continua sendo `id`/`cuid()`. Ele é atribuído por `EntidadeCodigoSequencia`
// no escopo `tenant`, dentro da mesma transação da criação — o `MAX + 1` que o
// frontend fazia some com esta missão. Escopo `tenant` e não `empresa` porque
// `Empresa` ainda não é model nativo (P6): numerar por empresa exigiria uma
// chave de escopo que o backend não consegue validar hoje, e uma sequência
// ancorada em id não verificável é pior que uma sequência mais larga.
//
// `empresa_id` é String simples, SEM relação Prisma, exatamente por isso. Ele
// carrega o valor que a Base44 já gravava, para que o filtro por empresa que a
// tela faz continue funcionando. Vira FK real quando `Empresa` for nativa.
//
// `ativo` é campo de negócio herdado do cadastro — NÃO é soft delete
// disfarçado. O contrato proíbe `ativoFieldReplacesDeletionPolicy`, e a P4.1
// não expõe exclusão: não existe `DELETE /setores/:id` (ver setorRoutes.js).
//
// `@@unique([cliente_id, id])` é a chave referenciável tenant-aware. Nada
// aponta para Setor ainda; ela existe para que a FK composta de `AreaPastagem`
// (P4.2) possa nascer tenant-aware sem migration de retrofit — o mesmo motivo
// pelo qual `Usuario` a declara desde a P3.
// ---------------------------------------------------------------------------
model Setor {
  id                 String   @id @default(cuid())
  cliente_id         String   @db.VarChar(64)
  empresa_id         String   @db.VarChar(64)
  numero_setor       String   @db.VarChar(32)
  nome               String   @db.VarChar(255)
  sigla              String?  @db.VarChar(32)
  // `default: "Próprio"` vem do contrato legado (`base44/entities/Setor.jsonc`).
  // A P4.1 trouxe o enum e a obrigatoriedade e deixou o default para trás; a
  // P4.1-R2 fecha isso com migration aditiva. Não torna o campo opcional na
  // API — ver D-PROD-25 §M.
  tipo               String   @default("Próprio") @db.VarChar(32)
  responsavel        String?  @db.VarChar(255)
  telefone           String?  @db.VarChar(64)
  endereco           String?  @db.VarChar(255)
  cidade             String?  @db.VarChar(255)
  estado             String?  @db.VarChar(8)
  area_total         Decimal? @db.Decimal(14, 4)
  capacidade_animais Int?
  observacoes        String?  @db.VarChar(2000)
  ativo              Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cliente Cliente        @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  areas   AreaPastagem[]
  lotes   Lote[]

  @@unique([cliente_id, numero_setor])
  @@unique([cliente_id, id])
  @@index([cliente_id, empresa_id])
  @@index([cliente_id, ativo])
  @@index([cliente_id, nome])
}

// ---------------------------------------------------------------------------
// Marca — cadastro de suporte migrado da Base44 (P4.4-Marcas, D-PROD-42).
//
// `numero_marca` é identificador de negócio, atribuído por
// `EntidadeCodigoSequencia` no escopo `tenant` (mesmo raciocínio de Setor:
// `Empresa` ainda não é model nativo). `empresa_id` é String simples, sem FK.
//
// Unicidade de nome é por empresa dentro do tenant — o cadastro legado já
// recusava duplicata case-insensitive; o backend normaliza para maiúsculas.
// ---------------------------------------------------------------------------
model Marca {
  id           String   @id @default(cuid())
  cliente_id   String   @db.VarChar(64)
  empresa_id   String   @db.VarChar(64)
  numero_marca String   @db.VarChar(32)
  nome         String   @db.VarChar(255)
  descricao    String?  @db.VarChar(2000)
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Restrict)

  @@unique([cliente_id, numero_marca])
  @@unique([cliente_id, id])
  @@unique([cliente_id, empresa_id, nome])
  @@index([cliente_id, empresa_id])
  @@index([cliente_id, ativo])
  @@index([cliente_id, nome])
}

// ---------------------------------------------------------------------------
// UnidadeMedida — cadastro de suporte (P4.5, D-PROD-44).
//
// `numero_unidade` vem de `EntidadeCodigoSequencia` (escopo tenant). A sigla é
// chave de negócio única por tenant — Produto na Base44 referencia por sigla.
// ---------------------------------------------------------------------------
model UnidadeMedida {
  id             String   @id @default(cuid())
  cliente_id     String   @db.VarChar(64)
  numero_unidade String   @db.VarChar(32)
  sigla          String   @db.VarChar(32)
  descricao      String   @db.VarChar(255)
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Restrict)

  @@unique([cliente_id, numero_unidade])
  @@unique([cliente_id, id])
  @@unique([cliente_id, sigla])
  @@index([cliente_id, ativo])
  @@index([cliente_id, sigla])
}

// ---------------------------------------------------------------------------
// GrupoAtividade — cadastro de tarefas (P5.0, D-PROD-45).
//
// Sem numeração de negócio. Nome único por tenant.
// ---------------------------------------------------------------------------
model GrupoAtividade {
  id          String   @id @default(cuid())
  cliente_id  String   @db.VarChar(64)
  nome_grupo  String   @db.VarChar(255)
  ativo       Boolean  @default(true)
  descricao   String?  @db.VarChar(2000)
  cor_icone   String?  @db.VarChar(64)
  observacoes String?  @db.VarChar(2000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cliente Cliente      @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  tipos   TipoTarefa[]

  @@unique([cliente_id, nome_grupo])
  @@unique([cliente_id, id])
  @@index([cliente_id, ativo])
}

// ---------------------------------------------------------------------------
// TipoTarefa — cadastro de tarefas (P5.0, D-PROD-45).
//
// FK composta para GrupoAtividade. `grupo_atividade_nome` é cache derivado do
// grupo na escrita — paridade com o legado Base44.
// ---------------------------------------------------------------------------
model TipoTarefa {
  id                   String   @id @default(cuid())
  cliente_id           String   @db.VarChar(64)
  nome_tipo            String   @db.VarChar(255)
  grupo_atividade_id   String   @db.VarChar(64)
  grupo_atividade_nome String   @db.VarChar(255)
  ativo                Boolean  @default(true)
  descricao            String?  @db.VarChar(2000)
  exige_area           Boolean  @default(false)
  pode_ter_produto     Boolean  @default(false)
  pode_ter_maquina     Boolean  @default(false)
  pode_ter_implemento  Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  cliente Cliente        @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  grupo   GrupoAtividade @relation(fields: [cliente_id, grupo_atividade_id], references: [cliente_id, id], onDelete: Restrict)

  @@unique([cliente_id, id])
  @@unique([cliente_id, grupo_atividade_id, nome_tipo])
  @@index([cliente_id, grupo_atividade_id])
  @@index([cliente_id, ativo])
}

// ---------------------------------------------------------------------------
// AreaPastagem — segunda capacidade de domínio migrada (P4.2, D-PROD-31).
//
// É o primeiro model deste repositório com FK **para outro model de domínio**.
// Tudo que a P4.1 preparou existe por causa dele: `Setor.@@unique([cliente_id,
// id])` nasceu sem consumidor justamente para que esta relação pudesse ser
// tenant-aware desde a primeira migration, sem retrofit.
//
// ─── Por que a FK é composta ───────────────────────────────────────────────
//
// `setor_id` sozinho apontaria para "algum setor do banco". Com duas FKs
// independentes — `cliente_id -> Cliente.id` e `setor_id -> Setor.id` — o
// PostgreSQL aceitaria uma área do Cliente A vinculada a um setor do Cliente B.
// O service nunca monta esse objeto, porque o tenant vem do `auth_context`; mas
// o contrato declara `crossTenantRelationsAllowed = false` e manda a constraint
// ser a última barreira. Regra que depende de o service estar certo não é
// barreira, é convenção. Mesmo raciocínio da FK composta de `AuditLog`.
//
// `onDelete: Restrict` fecha o outro lado: apagar um setor que ainda tem área
// falha no banco. Isso não reabre `DELETE /setores/:id` — a exclusão de setor
// continua fechada porque três dos quatro dependentes que a guarda consulta
// (`LancamentoTarefa`, `MovimentacaoMapa`, `MovimentacaoPecuaria`) seguem na
// Base44. Ver D-PROD-25 §N e D-PROD-31 §D.
//
// ─── setor_nome ────────────────────────────────────────────────────────────
//
// Denormalização herdada do legado, e mantida porque o mapa desenha o rótulo do
// setor sem carregar o setor. O que muda: o valor deixa de ser **enviado** pelo
// cliente e passa a ser **derivado** pelo servidor, na mesma transação, a partir
// da FK. É o que torna a divergência impossível em vez de improvável — hoje
// quem mantém isso alinhado é a `syncEntityReferences` da Base44, uma varredura
// que roda depois, pode falhar, e não tem transação.
//
// ─── quantidade_atual e status_ocupacao ────────────────────────────────────
//
// Continuam editáveis, e isso é dívida consciente (DBT-31). Os dois descrevem
// ocupação, que é consequência de `Lote` — entidade da P5. Enquanto o lote não
// for nativo, o backend não tem como derivá-los sem consultar a Base44, o que é
// proibido. Derivar de dado que ele não consegue ver seria pior que aceitar o
// valor: produziria um número errado com cara de calculado.
// ---------------------------------------------------------------------------
model AreaPastagem {
  id                           String   @id @default(cuid())
  cliente_id                   String   @db.VarChar(64)
  empresa_id                   String   @db.VarChar(64)
  setor_id                     String   @db.VarChar(64)
  // Derivado do setor vinculado, nunca do corpo da requisição.
  setor_nome                   String   @db.VarChar(255)
  numero_area                  String   @db.VarChar(32)
  nome                         String   @db.VarChar(255)
  sigla                        String?  @db.VarChar(32)
  tamanho_hectares             Decimal  @db.Decimal(14, 4)
  area_pastejada               Decimal? @db.Decimal(14, 4)
  capacidade_maxima            Decimal? @db.Decimal(14, 4)
  tipo_pastagem                String?  @db.VarChar(128)
  aproveitamento_classificacao String   @default("Média") @db.VarChar(32)
  tipo_cultura                 String   @default("Pastagem") @db.VarChar(32)
  cor                          String?  @db.VarChar(32)
  quantidade_atual             Int      @default(0)
  status_ocupacao              String   @default("Disponível") @db.VarChar(32)
  forragem_kg_ha               Decimal? @db.Decimal(14, 4)
  taxa_crescimento_kg_ha_dia   Decimal? @db.Decimal(14, 4)
  taxa_aproveitamento          Decimal? @db.Decimal(7, 4)
  periodo_estacao              String?  @db.VarChar(32)
  // Polígono do mapa: `{coords: [[lat, lng], ...], cor}`. Json porque a forma
  // pertence ao desenho, não ao domínio — e normalizar vértice em tabela
  // própria só faria sentido se alguém consultasse vértice, o que ninguém faz.
  coordenadas                  Json?
  observacoes                  String?  @db.VarChar(2000)
  ativo                        Boolean  @default(true)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  cliente       Cliente @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  setor         Setor   @relation(fields: [cliente_id, setor_id], references: [cliente_id, id], onDelete: Restrict)
  lotesEntrada  Lote[]  @relation("LoteAreaEntrada")
  lotesAtual    Lote[]  @relation("LoteAreaAtual")

  @@unique([cliente_id, numero_area])
  @@unique([cliente_id, id])
  @@index([cliente_id, empresa_id])
  @@index([cliente_id, setor_id])
  @@index([cliente_id, ativo])
  @@index([cliente_id, nome])
}

// ---------------------------------------------------------------------------
// ConfiguracaoIcone — geografia do mapa (P4.3, D-PROD-32).
//
// Sem numeração de negócio. `empresa_id` é String simples, sem FK — `Empresa`
// só é nativa na P6.
// ---------------------------------------------------------------------------
model ConfiguracaoIcone {
  id               String   @id @default(cuid())
  cliente_id       String   @db.VarChar(64)
  empresa_id       String?  @db.VarChar(64)
  tipo_entidade    String   @db.VarChar(64)
  categoria        String   @db.VarChar(255)
  icone_url        String?  @db.VarChar(1024)
  sub_icone_url    String?  @db.VarChar(1024)
  cor_padrao       String?  @db.VarChar(32)
  descricao        String?  @db.VarChar(2000)
  categorias_misto Json?
  ativo            Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Restrict)

  @@unique([cliente_id, id])
  @@index([cliente_id, tipo_entidade])
  @@index([cliente_id, ativo])
  @@index([cliente_id, categoria])
}

// ---------------------------------------------------------------------------
// PontoReferencia — geografia do mapa (P4.3, D-PROD-32).
//
// Exclusão física na API (`DELETE`), como no legado (`excluirPontoComCascata`).
// `configuracao_icone_id` é referência opaca — ícone nativo no mesmo tenant,
// sem FK composta nesta fatia.
// ---------------------------------------------------------------------------
model PontoReferencia {
  id                    String   @id @default(cuid())
  cliente_id            String   @db.VarChar(64)
  empresa_id            String   @db.VarChar(64)
  numero_ponto          String   @db.VarChar(32)
  nome                  String   @db.VarChar(255)
  sigla                 String?  @db.VarChar(32)
  tipo                  String   @db.VarChar(128)
  configuracao_icone_id String?  @db.VarChar(64)
  icone_url             String?  @db.VarChar(1024)
  sub_icone_url         String?  @db.VarChar(1024)
  coordenadas           Json?
  cor                   String?  @db.VarChar(32)
  observacoes           String?  @db.VarChar(2000)
  ativo                 Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Restrict)

  @@unique([cliente_id, numero_ponto])
  @@unique([cliente_id, id])
  @@index([cliente_id, empresa_id])
  @@index([cliente_id, ativo])
  @@index([cliente_id, nome])
}

// ---------------------------------------------------------------------------
// LinhaGeografica — geografia do mapa (P4.3, D-PROD-32).
//
// Baixa lógica via PATCH (`ativo: false`); não há rota DELETE.
// ---------------------------------------------------------------------------
model LinhaGeografica {
  id                 String   @id @default(cuid())
  cliente_id         String   @db.VarChar(64)
  empresa_id         String   @db.VarChar(64)
  numero_linha       String   @db.VarChar(32)
  nome               String   @db.VarChar(255)
  sigla              String?  @db.VarChar(32)
  tipo               String   @db.VarChar(64)
  coordenadas        Json?
  comprimento_metros Decimal? @db.Decimal(14, 4)
  cor                String?  @db.VarChar(32)
  observacoes        String?  @db.VarChar(2000)
  ativo              Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Restrict)

  @@unique([cliente_id, numero_linha])
  @@unique([cliente_id, id])
  @@index([cliente_id, empresa_id])
  @@index([cliente_id, ativo])
  @@index([cliente_id, nome])
}

// ---------------------------------------------------------------------------
// Lote — manejo pecuário (P5.1, D-PROD-47).
//
// Primeira entidade de manejo nativa. FKs compostas para Setor e AreaPastagem
// quando os ids estão presentes; caches denormalizados derivados na escrita.
// `Fornecedor` e `CategoriaManejo` continuam na Base44 — ids e nomes são strings.
// ---------------------------------------------------------------------------
model Lote {
  id                            String    @id @default(cuid())
  cliente_id                    String    @db.VarChar(64)
  empresa_id                    String    @db.VarChar(64)
  numero_lote                   String    @db.VarChar(32)
  nome                          String    @db.VarChar(255)
  identificador_nome            String?   @db.VarChar(255)
  identificador_sigla           String?   @db.VarChar(32)
  identificador_cor             String?   @db.VarChar(32)
  quantidade_cabecas            Int
  quantidade_entrada            Int
  categoria                     String?   @db.VarChar(128)
  categoria_entrada             String?   @db.VarChar(128)
  categoria_manejo_id           String?   @db.VarChar(64)
  categoria_manejo_nome         String?   @db.VarChar(255)
  categoria_manejo_entrada_id   String?   @db.VarChar(64)
  categoria_manejo_entrada_nome String?   @db.VarChar(255)
  sexo                          String?   @db.VarChar(32)
  peso_medio_kg                 Decimal?  @db.Decimal(14, 4)
  peso_entrada_kg               Decimal?  @db.Decimal(14, 4)
  idade_media_meses             Int?
  setor_id                      String?   @db.VarChar(64)
  setor_nome                    String?   @db.VarChar(255)
  area_entrada_id               String?   @db.VarChar(64)
  area_entrada_nome             String?   @db.VarChar(255)
  area_atual_id                 String?   @db.VarChar(64)
  area_atual_nome               String?   @db.VarChar(255)
  raca_predominante             String?   @db.VarChar(128)
  sistema_produtivo             String?   @db.VarChar(128)
  data_entrada                  DateTime? @db.Date
  motivo_entrada                String    @db.VarChar(32)
  origem                        String?   @db.VarChar(128)
  fornecedor_id                 String?   @db.VarChar(64)
  fornecedor_nome               String?   @db.VarChar(255)
  nota_fiscal                   String?   @db.VarChar(64)
  chave_nfe                     String?   @db.VarChar(64)
  numero_gta                    String?   @db.VarChar(64)
  cidade_origem                 String?   @db.VarChar(128)
  estado_origem                 String?   @db.VarChar(8)
  valor_total_compra            Decimal?  @db.Decimal(14, 4)
  valor_por_cabeca              Decimal?  @db.Decimal(14, 4)
  valor_frete                   Decimal?  @db.Decimal(14, 4)
  motivo_ajuste                 String?   @db.VarChar(255)
  motivo_outros                 String?   @db.VarChar(255)
  observacoes                   String?   @db.VarChar(2000)
  status                        String    @default("Ativo") @db.VarChar(32)
  campos_personalizados         Json      @default("{}")
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  cliente     Cliente       @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  setor       Setor?        @relation(fields: [cliente_id, setor_id], references: [cliente_id, id], onDelete: Restrict)
  areaEntrada AreaPastagem? @relation("LoteAreaEntrada", fields: [cliente_id, area_entrada_id], references: [cliente_id, id], onDelete: Restrict)
  areaAtual   AreaPastagem? @relation("LoteAreaAtual", fields: [cliente_id, area_atual_id], references: [cliente_id, id], onDelete: Restrict)

  @@unique([cliente_id, numero_lote])
  @@unique([cliente_id, id])
  @@index([cliente_id, empresa_id])
  @@index([cliente_id, setor_id])
  @@index([cliente_id, area_atual_id])
  @@index([cliente_id, status])
  @@index([cliente_id, nome])
}

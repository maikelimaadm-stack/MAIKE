  abastecimentosBem AbastecimentoBem[]
  // D-PROD-203 — formulações que vão ao cocho com este produto e ingredientes de
  // batelada (só relação Prisma; zero DDL em Produto).
  formulacoes            Formulacao[]
  ingredientesFormulacao FormulacaoIngrediente[]

  @@unique([cliente_id, numero_produto])
  @@unique([cliente_id, id])
  @@unique([cliente_id, empresa_id, nome_produto])
  @@index([cliente_id, empresa_id])
  @@index([cliente_id, ativo])
  @@index([cliente_id, nome_produto])
}

// ---------------------------------------------------------------------------
// LancamentoTarefa — manejo georreferenciado (P5.3, D-PROD-49).
//
// FK composta para TipoTarefa (obrigatório). Lote, área e grupo opcionais;
// caches denormalizados derivados na escrita. `ponto_suplementacao_id` permanece
// opaco — PontoSuplementacao ainda é Base44.
// ---------------------------------------------------------------------------
model LancamentoTarefa {
  id                     String    @id @default(cuid())
  cliente_id             String    @db.VarChar(64)
  empresa_id             String    @db.VarChar(64)
  titulo                 String    @db.VarChar(255)
  descricao              String?   @db.VarChar(2000)
  tipo                   String    @db.VarChar(64)
  tipo_tarefa_id         String    @db.VarChar(64)
  tipo_tarefa_nome       String    @db.VarChar(255)
  grupo_atividade_id     String?   @db.VarChar(64)
  grupo_atividade_nome   String?   @db.VarChar(255)
  solicitante            String?   @db.VarChar(255)
  data_pedido            DateTime? @db.Date
  setor_nome             String?   @db.VarChar(255)
  prioridade             String    @default("Média") @db.VarChar(32)
  status                 String    @default("Pendente") @db.VarChar(32)
  data_prevista          DateTime? @db.Date
  data_inicio            DateTime?
  data_conclusao         DateTime? @db.Date
  area_id                String?   @db.VarChar(64)
  area_nome              String?   @db.VarChar(255)
  lote_id                String?   @db.VarChar(64)
  lote_nome              String?   @db.VarChar(255)
  /// R2E-R1 (D-PROD-107): posição do ledger citada pelo mapa (lote_id continua sendo o CADASTRO da entrada).
  posicao_id             String?   @db.VarChar(64)
  ponto_suplementacao_id String?   @db.VarChar(64)
  coordenadas            Json?
  responsavel_id         String?   @db.VarChar(64)
  responsavel            String?   @db.VarChar(255)
  responsavel_geral      String?   @db.VarChar(255)
  observacoes            String?   @db.VarChar(2000)
  observacoes_conclusao  String?   @db.VarChar(2000)
  fotos                  String[]  @default([])
  anexos_urls            String[]  @default([])
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  cliente  Cliente         @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  tipoTarefa TipoTarefa    @relation(fields: [cliente_id, tipo_tarefa_id], references: [cliente_id, id], onDelete: Restrict)
  grupo    GrupoAtividade? @relation(fields: [cliente_id, grupo_atividade_id], references: [cliente_id, id], onDelete: Restrict)
  lote     Lote?           @relation(fields: [cliente_id, lote_id], references: [cliente_id, id], onDelete: Restrict)
  posicao  PosicaoRebanho? @relation(fields: [cliente_id, posicao_id], references: [cliente_id, id], onDelete: Restrict)
  area     AreaPastagem?   @relation(fields: [cliente_id, area_id], references: [cliente_id, id], onDelete: Restrict)
  historicos HistoricoLancamentoTarefa[]
  // D-PROD-190 — atividades executadas a partir desta demanda.
  atividades Atividade[]

  @@unique([cliente_id, id])
  @@index([cliente_id, empresa_id])
  @@index([cliente_id, tipo_tarefa_id])
  @@index([cliente_id, grupo_atividade_id])
  @@index([cliente_id, lote_id])
  @@index([cliente_id, posicao_id])
  @@index([cliente_id, area_id])
  @@index([cliente_id, status])
  @@index([cliente_id, updatedAt])
}

// ---------------------------------------------------------------------------
// HistoricoLancamentoTarefa — audit trail de tarefa (P5.3, D-PROD-49).
// ---------------------------------------------------------------------------
model HistoricoLancamentoTarefa {
  id            String   @id @default(cuid())
  cliente_id    String   @db.VarChar(64)
  empresa_id    String   @db.VarChar(64)
  tarefa_id     String   @db.VarChar(64)
  titulo_tarefa String?  @db.VarChar(255)
  evento        String   @db.VarChar(64)
  data_evento   DateTime
  status        String?  @db.VarChar(32)
  responsavel   String?  @db.VarChar(255)
  descricao     String?  @db.VarChar(2000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cliente Cliente          @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  tarefa  LancamentoTarefa @relation(fields: [cliente_id, tarefa_id], references: [cliente_id, id], onDelete: Cascade)

  @@unique([cliente_id, id])
  @@index([cliente_id, tarefa_id])
  @@index([cliente_id, empresa_id])
  @@index([cliente_id, data_evento])
}
// ---------------------------------------------------------------------------
// P5.4 — saída Base44: Empresa, estoque, suplementação, permissões (D-PROD-50+).
// ---------------------------------------------------------------------------

model Empresa {
  id                 String   @id @default(cuid())
  cliente_id         String   @db.VarChar(64)
  numero_empresa     Int
  apelido            String   @db.VarChar(255)
  nome               String   @db.VarChar(255)
  tipo_pessoa        String   @default("Jurídica") @db.VarChar(32)
  cpf                String?  @db.VarChar(32)
  rg                 String?  @db.VarChar(32)
  cnpj               String?  @db.VarChar(32)
  inscricao_estadual String?  @db.VarChar(64)
  telefone           String?  @db.VarChar(64)
  email              String?  @db.VarChar(255)
  endereco           String?  @db.VarChar(255)
  cidade             String?  @db.VarChar(128)
  estado             String?  @db.VarChar(8)
  cep                String?  @db.VarChar(16)
  logotipo_url       String?  @db.VarChar(2000)
  observacoes        String?  @db.VarChar(2000)
  /// D-PROD-122 (S1/H1): fuso IANA da fazenda ("America/Cuiaba"). Define o
  /// "hoje" do ledger do rebanho; nulo = não configurado (fato novo falha fechado).
  fuso_horario       String?  @db.VarChar(64)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Restrict)

  rebanhoAtivacao RebanhoLedgerAtivacao[]
  posicoesRebanho PosicaoRebanho[]
  eventosRebanho  EventoRebanho[]
  // D-PROD-146: cadastros de gestão (sem financeiro transacional).
  centrosCusto           CentroCusto[]
  centrosResultado       CentroResultado[]
  centrosCustoResultado  CentroCustoResultado[]
  naturezasFinanceiras   NaturezaFinanceira[]
  // D-PROD-155 — perfil financeiro e lançamentos da empresa.
  perfilFinanceiro       PerfilFinanceiroEmpresa?
  operacoesFinanceiras   OperacaoFinanceira[]
  // D-PROD-157 — bens patrimoniais da fazenda (catálogos são do tenant).
  bensPatrimoniais       BemPatrimonial[]
  // D-PROD-157 (R2) — produtos da fazenda vinculados a tipos de combustível.
  // D-PROD-159 — abastecimentos dos bens da fazenda.
  abastecimentosBem      AbastecimentoBem[]
  // D-PROD-188 — estações (águas/transição/seca) da fazenda.
  estacoes               CadEstacao[]
  // D-PROD-189 — curvas de ganho de peso da fazenda.
  curvasGanho            CadCurvaGanho[]
  // D-PROD-203 — formulações de suplemento da fazenda.
  formulacoes            Formulacao[]
  // D-PROD-190 — apontamentos de atividade da fazenda.
  atividades            Atividade[]
  atividadeApontamentos AtividadeApontamento[]
  @@unique([cliente_id, id])
  @@unique([cliente_id, numero_empresa])
  @@unique([cliente_id, nome])
  @@index([cliente_id, apelido])
}

model Permissao {
  id                    String   @id @default(cuid())
  cliente_id            String   @db.VarChar(64)
  user_email            String   @db.VarChar(255)
  user_nome             String?  @db.VarChar(255)
  modulos_permitidos    String[] @default([])
  permissoes_telas      Json     @default("[]")
  mobile_menu_ids       String[] @default([])
  is_admin              Boolean  @default(false)
  mapa_geral_permissoes Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Restrict)

  @@unique([cliente_id, id])
  @@unique([cliente_id, user_email])
}

model Fornecedor {
  id                 String    @id @default(cuid())
  cliente_id         String    @db.VarChar(64)
  empresa_id         String    @db.VarChar(64)
  numero_cadastro    String    @db.VarChar(32)
  tipo_pessoa        String    @db.VarChar(32)
  nome               String    @db.VarChar(255)
  cpf                String?   @db.VarChar(32)
  rg                 String?   @db.VarChar(32)
  data_nascimento    DateTime? @db.Date
  cnpj               String?   @db.VarChar(32)
  razao_social       String?   @db.VarChar(255)
  inscricao_estadual String?   @db.VarChar(64)
  nome_responsavel   String?   @db.VarChar(255)
  telefone           String?   @db.VarChar(64)
  email              String?   @db.VarChar(255)
  endereco           String?   @db.VarChar(255)
  cidade             String?   @db.VarChar(128)
  codigo_ibge        String?   @db.VarChar(16)
  estado             String?   @db.VarChar(8)
  cep                String?   @db.VarChar(16)
  observacoes        String?   @db.VarChar(2000)
  tipos              String[]  @default([])
  ativo              Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  // D-PROD-155 — o parceiro do lançamento e dos títulos.
  operacoesFinanceiras OperacaoFinanceira[]
  titulosFinanceiros   TituloFinanceiro[]
  // D-PROD-157 — proprietário (bem de terceiro) e fornecedor da aquisição.
  bensComoProprietario BemPatrimonial[]   @relation("BemPatrimonialProprietario")
  bensComoFornecedor   BemPatrimonial[]   @relation("BemPatrimonialFornecedor")

  @@unique([cliente_id, id])
  @@unique([cliente_id, numero_cadastro])
  @@index([cliente_id, empresa_id])
}

// D-PROD-186 — MAIKE-CATEGORIA-MANEJO-ENXUGAR (Fatia C): `raca`,
// `categoria_oficial`, `ganho_peso_anual_kg` e `gmd_janeiro`…`gmd_dezembro`
// SAÍRAM do contrato (API, services, auditoria, UI).
// D-PROD-187 — MAIKE-CATEGORIA-MANEJO-CADCATEGORIA (Fatia D): essas 15 colunas
// e o vínculo com o ícone oficial (`catalogo_categoria_visual_id`, com a FK e o
// índice; emenda do proprietário) foram APAGADOS do banco, e a tabela física
// passou a se chamar `CADCATEGORIA` (migration CONTRACT
// `20261113500000_categoria_manejo_cadcategoria`). O model continua
// `CategoriaManejo` (delegate `prisma.categoriaManejo`, rotas, permissões e
// AuditLog `entidade: 'CategoriaManejo'` não mudam); SQL bruto usa
// "CADCATEGORIA", com aspas.
model CategoriaManejo {
  id                    String   @id @default(cuid())
  cliente_id            String   @db.VarChar(64)
  empresa_id            String   @db.VarChar(64)
  nome                  String   @db.VarChar(255)
  sigla                 String?  @db.VarChar(32)
  especie               String?  @db.VarChar(128)
  sexo                  String?  @db.VarChar(32)
  idade_minima_meses    Int?
  idade_maxima_meses    Int?
  // D-PROD-195: curva de ganho da categoria, obrigatória e da MESMA fazenda (FK composta).
  curva_ganho_id        String   @db.VarChar(64)
  // D-PROD-198: peso que a categoria quer atingir (kg por cabeça), opcional; a
  // projeção do lote mostra quando ele chega lá.
  peso_objetivo_kg      Decimal? @db.Decimal(10, 2)
  ativo                 Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  cliente    Cliente       @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  curvaGanho CadCurvaGanho @relation(fields: [cliente_id, empresa_id, curva_ganho_id], references: [cliente_id, empresa_id, id], onDelete: Restrict)
  // D-PROD-203 — exceções de consumo das formulações (só relação Prisma; zero DDL em CADCATEGORIA).
  regrasFormulacao FormulacaoRegraCategoria[]

  @@unique([cliente_id, id])
  @@index([cliente_id, empresa_id])
  @@index([cliente_id, empresa_id, curva_ganho_id])
  @@map("CADCATEGORIA")
}

model Bebedouro {
  id                         String   @id @default(cuid())
  cliente_id                 String   @db.VarChar(64)
  empresa_id                 String   @db.VarChar(64)
  ponto_referencia_id        String?  @db.VarChar(64)
  nome                       String   @db.VarChar(255)
  codigo_interno             String?  @db.VarChar(64)
  pasto_id                   String?  @db.VarChar(64)
  pasto_nome                 String?  @db.VarChar(255)
  area_vinculada_ids         String[] @default([])
  area_vinculada_nomes       String[] @default([])
  setor_id                   String?  @db.VarChar(64)
  setor_nome                 String?  @db.VarChar(255)
  tipo                       String   @db.VarChar(64)
  capacidade_litros          Decimal? @db.Decimal(14, 4)
  origem_agua                String?  @db.VarChar(64)
  coordenadas                Json?
